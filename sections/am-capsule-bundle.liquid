{% comment %}
  Atelier Modernista — Capsule Bundle
  For collection pages tagged "capsule": shows the artist story, the
  bundled pieces, and an "Add Set to Cart" action.

  The X% savings this section promotes is only ever shown once
  `discount_confirmed` is switched on in the section settings — meaning
  a matching Shopify Automatic Discount (Amount off products, scoped to
  this collection, minimum quantity = number of pieces) has been created
  and tested in Admin. The savings figure shown *after* adding to cart is
  read back from the live cart response, never assumed from a setting.
{% endcomment %}

{%- assign cn_note = collection.metafields['custom']['curatorial_note'].value -%}
{%- assign cn_source = collection.metafields['custom']['curatorial_note_source'].value -%}
{%- assign cn_image = collection.metafields['custom']['curatorial_note_image'].value -%}
{%- assign look_image = collection.metafields['custom']['look_image'].value -%}

<section
  id="am-capsule-{{ section.id }}"
  class="am-capsule"
  data-discount-confirmed="{{ section.settings.discount_confirmed }}"
  data-discount-percentage="{{ section.settings.discount_percentage }}"
>
  <div class="am-capsule__inner">

    <header class="am-capsule__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="am-capsule__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="am-capsule__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="am-capsule__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- if section.settings.discount_confirmed -%}
        <p class="am-capsule__discount-badge">
          {{ section.settings.discount_percentage }}% off when bought as a set
        </p>
      {%- endif -%}
    </header>

    {%- if look_image != blank -%}
      <div class="am-capsule__look">
        <img
          src="{{ look_image | image_url: width: 1400 }}"
          srcset="
            {{ look_image | image_url: width: 700 }} 700w,
            {{ look_image | image_url: width: 1000 }} 1000w,
            {{ look_image | image_url: width: 1400 }} 1400w
          "
          sizes="(max-width: 749px) 92vw, 1120px"
          alt="{{ look_image.alt | default: collection.title | escape }}"
          width="{{ look_image.width }}"
          height="{{ look_image.height }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}

    <div class="am-capsule__products">
      {%- for product in collection.products -%}
        {%- assign default_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
        <article
          class="am-capsule-card"
          data-am-capsule-card
          data-product-available="{{ product.available }}"
          data-price-cents="{{ default_variant.price }}"
        >
          <a href="{{ product.url }}" class="am-capsule-card__image-link" aria-label="View {{ product.title | escape }}">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                srcset="
                  {{ product.featured_image | image_url: width: 320 }} 320w,
                  {{ product.featured_image | image_url: width: 480 }} 480w,
                  {{ product.featured_image | image_url: width: 640 }} 640w,
                  {{ product.featured_image | image_url: width: 800 }} 800w
                "
                sizes="(max-width: 749px) 88vw, (max-width: 989px) 340px, 300px"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'am-capsule-card__placeholder' }}
            {%- endif -%}
          </a>

          <div class="am-capsule-card__body">
            <h3 class="am-capsule-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            {%- if product.variants.size > 1 -%}
              <select class="am-capsule-card__variant-select" data-am-capsule-variant-select>
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    {% if variant == default_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            {%- else -%}
              <input type="hidden" data-am-capsule-single-variant value="{{ default_variant.id }}">
            {%- endif -%}

            <p class="am-capsule-card__price" data-am-capsule-card-price>
              {{ default_variant.price | money_without_trailing_zeros }}
            </p>
          </div>

          <input type="hidden" data-am-capsule-variant-id value="{{ default_variant.id }}">
        </article>
      {%- else -%}
        <p class="am-capsule__empty">No pieces are currently assigned to this capsule.</p>
      {%- endfor -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="am-capsule__summary">
        <div class="am-capsule__summary-row">
          <span>Set subtotal</span>
          <span data-am-capsule-subtotal>—</span>
        </div>

        <button
          type="button"
          class="am-capsule__add"
          data-am-capsule-add
          data-default-label="{{ section.settings.cta_label | escape }}"
        >
          {{ section.settings.cta_label }}
        </button>

        <p class="am-capsule__unavailable" data-am-capsule-unavailable hidden>
          One or more pieces in this set is currently sold out.
        </p>

        <p class="am-capsule__message" data-am-capsule-message role="status" aria-live="polite"></p>
      </div>
    {%- endif -%}

    {%- if cn_note != blank or cn_image != blank -%}
      <div class="am-capsule__story">
        {%- if cn_image != blank -%}
          <div class="am-capsule__story-image">
            <img
              src="{{ cn_image | image_url: width: 900 }}"
              alt="{{ cn_image.alt | default: 'Artist portrait' | escape }}"
              width="{{ cn_image.width }}"
              height="{{ cn_image.height }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        <div class="am-capsule__story-body">
          <p class="am-capsule__story-label">The artist</p>
          {%- if cn_note != blank -%}
            <blockquote class="am-capsule__story-quote">
              <p>{{ cn_note }}</p>
            </blockquote>
          {%- endif -%}
          {%- if cn_source != blank -%}
            <p class="am-capsule__story-source">{{ cn_source }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #am-capsule-{{ section.id }} {
    background: {{ section.settings.background_colour }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #am-capsule-{{ section.id }} .am-capsule__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #am-capsule-{{ section.id }} .am-capsule__intro {
    max-width: 640px;
    margin: 0 auto 40px;
    text-align: center;
  }

  #am-capsule-{{ section.id }} .am-capsule__eyebrow {
    margin: 0 0 12px;
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #0047AB;
  }

  #am-capsule-{{ section.id }} .am-capsule__heading {
    margin: 0 0 14px;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 400;
    line-height: 1.08;
    color: #1a1a18;
  }

  #am-capsule-{{ section.id }} .am-capsule__subheading {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(26, 26, 24, 0.65);
  }

  #am-capsule-{{ section.id }} .am-capsule__discount-badge {
    display: inline-block;
    margin: 20px 0 0;
    padding: 8px 18px;
    background: #0047AB;
    color: #fdf6e3;
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #am-capsule-{{ section.id }} .am-capsule__look {
    margin-bottom: 48px;
    background: #f7f0e6;
  }

  #am-capsule-{{ section.id }} .am-capsule__look img {
    display: block;
    width: 100%;
    max-height: 640px;
    object-fit: cover;
  }

  #am-capsule-{{ section.id }} .am-capsule__products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
    margin-bottom: 40px;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__image-link {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 71, 171, 0.025);
  }

  #am-capsule-{{ section.id }} .am-capsule-card__image-link img,
  #am-capsule-{{ section.id }} .am-capsule-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__body {
    padding-top: 16px;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__title {
    margin: 0 0 10px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    font-weight: 400;
    line-height: 1.2;
    color: #1a1a18;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__title a:hover {
    color: #0047AB;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__variant-select {
    width: 100%;
    min-height: 40px;
    padding: 0 12px;
    margin-bottom: 10px;
    border: 1px solid rgba(26, 26, 24, 0.2);
    background: transparent;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    color: #1a1a18;
  }

  #am-capsule-{{ section.id }} .am-capsule-card__price {
    margin: 0;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #1a1a18;
  }

  #am-capsule-{{ section.id }} [data-am-capsule-card][data-product-available="false"] {
    opacity: 0.55;
  }

  #am-capsule-{{ section.id }} .am-capsule__summary {
    max-width: 420px;
    margin: 0 auto;
    padding: 28px 32px;
    background: #f7f0e6;
    text-align: center;
  }

  #am-capsule-{{ section.id }} .am-capsule__summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: rgba(26, 26, 24, 0.75);
  }

  #am-capsule-{{ section.id }} [data-am-capsule-subtotal] {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    color: #1a1a18;
  }

  #am-capsule-{{ section.id }} .am-capsule__add {
    display: block;
    width: 100%;
    min-height: 50px;
    padding: 13px 22px;
    border: 1px solid #0047AB;
    background: #0047AB;
    color: #fdf6e3;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, opacity 180ms ease;
  }

  #am-capsule-{{ section.id }} .am-capsule__add:hover:not(:disabled) {
    background: #003080;
  }

  #am-capsule-{{ section.id }} .am-capsule__add:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  #am-capsule-{{ section.id }} .am-capsule__unavailable {
    margin: 14px 0 0;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    color: #a33;
  }

  #am-capsule-{{ section.id }} .am-capsule__message {
    min-height: 18px;
    margin: 12px 0 0;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: #0047AB;
  }

  #am-capsule-{{ section.id }} .am-capsule__story {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid rgba(26, 26, 24, 0.12);
  }

  #am-capsule-{{ section.id }} .am-capsule__story-image {
    flex: 1 1 320px;
    max-width: 420px;
    overflow: hidden;
  }

  #am-capsule-{{ section.id }} .am-capsule__story-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #am-capsule-{{ section.id }} .am-capsule__story-body {
    flex: 1 1 320px;
  }

  #am-capsule-{{ section.id }} .am-capsule__story-label {
    margin: 0 0 20px;
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #0047AB;
  }

  #am-capsule-{{ section.id }} .am-capsule__story-quote {
    margin: 0 0 16px;
    padding: 0;
    border: none;
  }

  #am-capsule-{{ section.id }} .am-capsule__story-quote p {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.4;
    color: #1a1a18;
  }

  #am-capsule-{{ section.id }} .am-capsule__story-source {
    margin: 0;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(26, 26, 24, 0.55);
  }

  #am-capsule-{{ section.id }} .am-capsule__empty {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-style: italic;
    color: rgba(26, 26, 24, 0.5);
  }

  @media screen and (max-width: 749px) {
    #am-capsule-{{ section.id }} .am-capsule__story {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  (function () {
    const root = document.getElementById('am-capsule-{{ section.id }}');
    if (!root || root.dataset.amCapsuleInitialised === 'true') return;
    root.dataset.amCapsuleInitialised = 'true';

    const CURRENCY = '{{ cart.currency.iso_code }}';

    function money(cents) {
      return new Intl.NumberFormat(undefined, {
        style: 'currency', currency: CURRENCY, maximumFractionDigits: 2
      }).format((Number(cents) || 0) / 100);
    }

    function getCards() {
      return Array.from(root.querySelectorAll('[data-am-capsule-card]'));
    }

    function currentSelection(card) {
      const select = card.querySelector('[data-am-capsule-variant-select]');
      const hiddenInput = card.querySelector('[data-am-capsule-single-variant]');
      if (select) {
        const opt = select.options[select.selectedIndex];
        return { variantId: Number(select.value), price: Number(opt ? opt.dataset.price : 0), available: opt ? !opt.disabled : false };
      }
      if (hiddenInput) {
        return { variantId: Number(hiddenInput.value), price: Number(card.dataset.priceCents || 0), available: card.dataset.productAvailable === 'true' };
      }
      return { variantId: null, price: 0, available: false };
    }

    function updateSummary() {
      const cards = getCards();
      let subtotal = 0;
      let allAvailable = true;

      cards.forEach(function (card) {
        const selection = currentSelection(card);
        const idInput = card.querySelector('[data-am-capsule-variant-id]');
        if (idInput) idInput.value = selection.variantId || '';

        card.dataset.priceCents = String(selection.price);

        const priceEl = card.querySelector('[data-am-capsule-card-price]');
        if (priceEl) priceEl.textContent = money(selection.price);

        subtotal += selection.price || 0;
        if (!selection.available) allAvailable = false;
      });

      const subtotalEl = root.querySelector('[data-am-capsule-subtotal]');
      if (subtotalEl) subtotalEl.textContent = money(subtotal);

      const addBtn = root.querySelector('[data-am-capsule-add]');
      const unavailableEl = root.querySelector('[data-am-capsule-unavailable]');
      if (addBtn) addBtn.disabled = !allAvailable || cards.length === 0;
      if (unavailableEl) unavailableEl.hidden = allAvailable;
    }

    root.addEventListener('change', function (event) {
      if (event.target.matches('[data-am-capsule-variant-select]')) updateSummary();
    });

    const addBtn = root.querySelector('[data-am-capsule-add]');
    if (addBtn) {
      addBtn.addEventListener('click', async function () {
        const defaultLabel = addBtn.dataset.defaultLabel || 'Add Set to Cart';
        const message = root.querySelector('[data-am-capsule-message]');
        const cards = getCards();
        const variantIds = cards
          .map(function (card) { return Number(card.querySelector('[data-am-capsule-variant-id]').value); })
          .filter(Boolean);

        if (variantIds.length === 0) return;

        addBtn.disabled = true;
        addBtn.textContent = 'Adding…';
        if (message) message.textContent = '';

        try {
          const addResponse = await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ items: variantIds.map(function (id) { return { id: id, quantity: 1 }; }) })
          });
          const addResult = await addResponse.json();
          if (!addResponse.ok) throw new Error(addResult.description || 'Unable to add this set');

          // Verify the real discount from the live cart — never assumed from a setting.
          const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
          const cart = await cartResponse.json();

          let originalTotal = 0;
          let discountTotal = 0;

          (cart.items || []).forEach(function (line) {
            if (variantIds.indexOf(line.variant_id) === -1) return;
            originalTotal += line.original_line_price || 0;
            (line.discount_allocations || []).forEach(function (allocation) {
              discountTotal += allocation.amount || 0;
            });
          });

          if (discountTotal > 0 && originalTotal > 0) {
            const percent = Math.round((discountTotal / originalTotal) * 100);
            if (message) {
              message.textContent = 'Added to your bag — ' + money(discountTotal) + ' (' + percent + '%) saved on this set.';
            }
          } else if (message) {
            message.textContent = 'Added to your bag.';
          }

          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: addResult }));

          addBtn.textContent = 'Added ✓';
          setTimeout(function () {
            addBtn.textContent = defaultLabel;
            addBtn.disabled = false;
          }, 2200);
        } catch (error) {
          console.error('[AM Capsule]', error);
          if (message) message.textContent = 'This set could not be added. Please try again.';
          addBtn.textContent = defaultLabel;
          addBtn.disabled = false;
        }
      });
    }

    updateSummary();
  })();
</script>

{% schema %}
{
  "name": "AM — Capsule Bundle",
  "tag": "section",
  "class": "am-capsule-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A Capsule Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the complete set"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three pieces from one artist, designed to be worn together."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Add to cart button label",
      "default": "Add Set to Cart"
    },
    {
      "type": "header",
      "content": "Discount (confirm in Admin first)"
    },
    {
      "type": "checkbox",
      "id": "discount_confirmed",
      "label": "Discount is live and tested in Shopify Admin",
      "info": "Only turn this on after creating and test-purchasing a matching Automatic Discount (Amount off products, scoped to this collection, minimum quantity = number of pieces). Until this is on, no percentage is shown to shoppers.",
      "default": false
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "label": "Discount percentage",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 15,
      "info": "Must exactly match the value set on the Automatic Discount in Admin."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_colour",
      "label": "Background colour",
      "default": "#fdf6e3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "AM — Capsule Bundle"
    }
  ]
}
{% endschema %}
