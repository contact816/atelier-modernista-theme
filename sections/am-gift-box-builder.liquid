{%- comment -%}
  Atelier Modernista x The Style Chapter - Gift Box Builder (v2: three boxes, 4 included pieces + upgrade)
  File: sections/am-gift-box-builder.liquid

  HOW PRICING WORKS
  - Each box's advertised price INCLUDES one jewellery piece, e.g. £39 / £49 / £59.
  - The chosen jewellery goes into the bag as its OWN Shopify variant (so stock decrements).
  - To avoid charging twice:  BOX PRODUCT PRICE = advertised price minus INCLUDED JEWELLERY PRICE.
      Included jewellery products are priced at £20  ->  box products at £19 / £29 / £39.
  - Set "Included jewellery price" on each box block to 20 (the shop price of the 4 included pieces).
  - Upgrade pieces are priced higher (e.g. £30). The customer pays only the difference over £20.
  - Every price in the bag is a real Shopify price, so checkout always verifies it.
{%- endcomment -%}

{%- liquid
  assign first_box = ''
  assign box_count = 0
  for block in section.blocks
    if block.type == 'box' and block.settings.product != blank
      assign box_count = box_count | plus: 1
      if first_box == ''
        assign first_box = block.id
      endif
    endif
  endfor
  assign has_upgrades = false
  assign has_extras = false
  for block in section.blocks
    if block.type == 'jewellery' and block.settings.tier == 'upgrade' and block.settings.product != blank
      assign has_upgrades = true
    endif
    if block.type == 'extra' and block.settings.product != blank
      assign has_extras = true
    endif
  endfor
-%}

<style>
  #amgb-{{ section.id }} {
    --amgb-cobalt: #0047AB;
    --amgb-cream: #FDF6E3;
    --amgb-linen: #f7f0e6;
    --amgb-ink: #1a1a18;
    --amgb-burgundy: #7a1f2b;
    --amgb-line: rgba(26, 26, 24, 0.14);
    background: var(--amgb-cream);
    color: var(--amgb-ink);
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    line-height: 1.5;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #amgb-{{ section.id }} * { box-sizing: border-box; }
  #amgb-{{ section.id }} .amgb-wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  #amgb-{{ section.id }} .amgb-head { text-align: center; max-width: 620px; margin: 0 auto 28px; }
  #amgb-{{ section.id }} .amgb-eyebrow { font-size: 11px; letter-spacing: 2.4px; text-transform: uppercase; color: var(--amgb-burgundy); margin: 0 0 8px; }
  #amgb-{{ section.id }} .amgb-title { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: clamp(30px, 4.4vw, 42px); line-height: 1.1; margin: 0 0 10px; color: var(--amgb-ink); }
  #amgb-{{ section.id }} .amgb-intro { margin: 0; font-size: 15px; opacity: 0.8; }

  #amgb-{{ section.id }} .amgb-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 36px; align-items: start; }
  #amgb-{{ section.id }} .amgb-step { margin: 0 0 30px; }
  #amgb-{{ section.id }} .amgb-step__title { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 24px; margin: 0 0 4px; }
  #amgb-{{ section.id }} .amgb-step__title span { color: var(--amgb-burgundy); margin-right: 8px; }
  #amgb-{{ section.id }} .amgb-step__sub { margin: 0 0 14px; font-size: 13px; opacity: 0.7; }
  #amgb-{{ section.id }} .amgb-visually { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }

  /* Boxes */
  #amgb-{{ section.id }} .amgb-boxes { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; }
  #amgb-{{ section.id }} .amgb-box { display: block; position: relative; cursor: pointer; }
  #amgb-{{ section.id }} .amgb-box__inner { display: block; background: #fff; border: 1px solid var(--amgb-line); height: 100%; transition: border-color 0.2s, outline-color 0.2s; outline: 2px solid transparent; outline-offset: -1px; }
  #amgb-{{ section.id }} .amgb-box input:checked + .amgb-box__inner { outline-color: var(--amgb-cobalt); border-color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-box input:focus-visible + .amgb-box__inner { outline-color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-box.is-soldout { cursor: not-allowed; }
  #amgb-{{ section.id }} .amgb-box.is-soldout .amgb-box__inner { opacity: 0.45; }
  #amgb-{{ section.id }} .amgb-box__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--amgb-linen); }
  #amgb-{{ section.id }} .amgb-box__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #amgb-{{ section.id }} .amgb-box__body { display: block; padding: 14px 16px 16px; }
  #amgb-{{ section.id }} .amgb-box__title { display: block; font-family: 'Cormorant Garamond', serif; font-size: 21px; line-height: 1.15; margin-bottom: 4px; }
  #amgb-{{ section.id }} .amgb-box__desc { display: block; font-size: 13px; opacity: 0.75; margin-bottom: 8px; }
  #amgb-{{ section.id }} .amgb-box__price { display: block; font-weight: 500; color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-boxopt { margin-top: 12px; }
  #amgb-{{ section.id }} .amgb-boxopt label { display: block; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 6px; }
  #amgb-{{ section.id }} select { width: 100%; font-family: 'Jost', sans-serif; font-size: 14px; padding: 10px 12px; border: 1px solid var(--amgb-line); background: #fff; color: var(--amgb-ink); border-radius: 0; }

  /* Jewellery grids */
  #amgb-{{ section.id }} .amgb-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  #amgb-{{ section.id }} .amgb-card { display: block; position: relative; cursor: pointer; }
  #amgb-{{ section.id }} .amgb-card__inner { display: block; background: #fff; border: 1px solid var(--amgb-line); height: 100%; outline: 2px solid transparent; outline-offset: -1px; transition: outline-color 0.2s, border-color 0.2s; }
  #amgb-{{ section.id }} .amgb-card input:checked + .amgb-card__inner { outline-color: var(--amgb-cobalt); border-color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-card input:focus-visible + .amgb-card__inner { outline-color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-card.is-soldout { cursor: not-allowed; }
  #amgb-{{ section.id }} .amgb-card.is-soldout .amgb-card__inner { opacity: 0.45; }
  #amgb-{{ section.id }} .amgb-card__img { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: var(--amgb-linen); }
  #amgb-{{ section.id }} .amgb-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #amgb-{{ section.id }} .amgb-card__body { display: block; padding: 10px 12px 12px; }
  #amgb-{{ section.id }} .amgb-card__name { display: block; font-size: 14px; line-height: 1.3; margin-bottom: 3px; }
  #amgb-{{ section.id }} .amgb-card__tag { display: block; font-size: 12px; letter-spacing: 0.8px; text-transform: uppercase; color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-card[data-tier="upgrade"] .amgb-card__tag { color: var(--amgb-burgundy); }
  #amgb-{{ section.id }} .amgb-card select { margin-top: 8px; padding: 7px 8px; font-size: 13px; }

  #amgb-{{ section.id }} .amgb-upgrade-toggle { margin-top: 16px; background: transparent; border: 1px solid var(--amgb-cobalt); color: var(--amgb-cobalt); font-family: 'Jost', sans-serif; font-size: 12px; letter-spacing: 1.8px; text-transform: uppercase; padding: 12px 18px; cursor: pointer; transition: background 0.2s, color 0.2s; }
  #amgb-{{ section.id }} .amgb-upgrade-toggle:hover, #amgb-{{ section.id }} .amgb-upgrade-toggle[aria-expanded="true"] { background: var(--amgb-cobalt); color: #fff; }
  #amgb-{{ section.id }} .amgb-upgrade { margin-top: 16px; }
  #amgb-{{ section.id }} .amgb-upgrade[hidden] { display: none; }
  #amgb-{{ section.id }} .amgb-upgrade__sub { margin: 0 0 12px; font-size: 13px; opacity: 0.75; }

  /* Extras */
  #amgb-{{ section.id }} .amgb-extras { display: grid; gap: 10px; }
  #amgb-{{ section.id }} .amgb-extra { display: block; cursor: pointer; position: relative; }
  #amgb-{{ section.id }} .amgb-extra__inner { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--amgb-line); padding: 10px; outline: 2px solid transparent; outline-offset: -1px; }
  #amgb-{{ section.id }} .amgb-extra input:checked + .amgb-extra__inner { outline-color: var(--amgb-cobalt); border-color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-extra__img { flex: 0 0 64px; width: 64px; height: 64px; overflow: hidden; background: var(--amgb-linen); }
  #amgb-{{ section.id }} .amgb-extra__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #amgb-{{ section.id }} .amgb-extra__text { flex: 1; }
  #amgb-{{ section.id }} .amgb-extra__name { display: block; font-size: 14px; }
  #amgb-{{ section.id }} .amgb-extra__price { display: block; font-size: 13px; color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-extra.is-soldout { opacity: 0.45; cursor: not-allowed; }

  /* Message */
  #amgb-{{ section.id }} textarea { width: 100%; min-height: 96px; font-family: 'Jost', sans-serif; font-size: 14px; padding: 12px; border: 1px solid var(--amgb-line); background: #fff; color: var(--amgb-ink); resize: vertical; border-radius: 0; }
  #amgb-{{ section.id }} textarea:focus, #amgb-{{ section.id }} select:focus { outline: 2px solid var(--amgb-cobalt); outline-offset: -1px; }

  /* Summary */
  #amgb-{{ section.id }} .amgb-summary { background: var(--amgb-linen); border: 1px solid var(--amgb-line); padding: 20px; position: sticky; top: 20px; }
  #amgb-{{ section.id }} .amgb-summary__title { font-family: 'Cormorant Garamond', serif; font-size: 22px; margin: 0 0 12px; }
  #amgb-{{ section.id }} .amgb-lines { list-style: none; margin: 0 0 12px; padding: 0; }
  #amgb-{{ section.id }} .amgb-lines li { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; padding: 6px 0; border-bottom: 1px solid var(--amgb-line); }
  #amgb-{{ section.id }} .amgb-lines li span:first-child { flex: 1; }
  #amgb-{{ section.id }} .amgb-total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; font-weight: 500; margin-bottom: 14px; }
  #amgb-{{ section.id }} .amgb-total strong { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 500; color: var(--amgb-cobalt); }
  #amgb-{{ section.id }} .amgb-btn { width: 100%; border: 0; background: var(--amgb-cobalt); color: #fff; font-family: 'Jost', sans-serif; font-size: 13px; letter-spacing: 1.8px; text-transform: uppercase; padding: 16px 12px; cursor: pointer; transition: background 0.2s; }
  #amgb-{{ section.id }} .amgb-btn:hover:not(:disabled) { background: #003a8f; }
  #amgb-{{ section.id }} .amgb-btn:disabled { background: #9aa5b8; cursor: not-allowed; }
  #amgb-{{ section.id }} .amgb-hint { margin: 10px 0 0; font-size: 12px; opacity: 0.75; text-align: center; min-height: 18px; }
  #amgb-{{ section.id }} .amgb-error { margin: 10px 0 0; font-size: 13px; color: var(--amgb-burgundy); }
  #amgb-{{ section.id }} .amgb-reassure { margin: 12px 0 0; font-size: 12px; text-align: center; opacity: 0.7; }

  #amgb-{{ section.id }} .amgb-notice { background: #fff; border: 1px dashed var(--amgb-burgundy); padding: 14px 16px; margin: 0 0 24px; font-size: 13px; }
  #amgb-{{ section.id }} .amgb-notice p { margin: 0 0 6px; }
  #amgb-{{ section.id }} .amgb-empty { text-align: center; padding: 40px 20px; font-family: 'Cormorant Garamond', serif; font-size: 22px; }

  @media (max-width: 899px) {
    #amgb-{{ section.id }} .amgb-layout { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    #amgb-{{ section.id }} .amgb-summary { position: static; }
  }
  @media (max-width: 749px) {
    #amgb-{{ section.id }} .amgb-wrap { padding: 0 16px; }
    #amgb-{{ section.id }} .amgb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    #amgb-{{ section.id }} .amgb-boxes { grid-template-columns: minmax(0, 1fr); }
    #amgb-{{ section.id }} .amgb-box__img { aspect-ratio: 16 / 10; }
  }
</style>

<section id="amgb-{{ section.id }}" class="amgb">
  <div class="amgb-wrap">

    <header class="amgb-head">
      {%- if section.settings.eyebrow != blank -%}<p class="amgb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="amgb-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<p class="amgb-intro">{{ section.settings.intro }}</p>{%- endif -%}
    </header>

    {%- if request.design_mode -%}
      <div class="amgb-notice">
        <p><strong>Setup check (only visible in the theme editor)</strong></p>
        {%- for box in section.blocks -%}
          {%- if box.type == 'box' -%}
            {%- assign bp = box.settings.product -%}
            {%- if bp == blank -%}
              <p>A box block has no product selected. It stays hidden on the live page.</p>
            {%- else -%}
              {%- assign bv = bp.selected_or_first_available_variant -%}
              {%- assign ref = box.settings.included_value | times: 100 | round -%}
              <p>{{ bp.title }}: box product {{ bv.price | money }} + included jewellery {{ ref | money }} = <strong>{{ bv.price | plus: ref | money }}</strong> advertised.</p>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'jewellery' -%}
            {%- assign jp = block.settings.product -%}
            {%- if jp == blank -%}
              <p>A jewellery block has no product selected. It will not show.</p>
            {%- elsif block.settings.tier == 'included' -%}
              {%- assign jv = jp.selected_or_first_available_variant -%}
              {%- for box in section.blocks -%}
                {%- if box.type == 'box' -%}
                  {%- assign ref = box.settings.included_value | times: 100 | round -%}
                  {%- if jv.price != ref -%}
                    <p>Included piece "{{ jp.title }}" is {{ jv.price | money }} but "{{ box.settings.title | default: box.settings.product.title }}" expects {{ ref | money }}. Its total will be wrong.</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if box_count == 0 -%}
      <p class="amgb-empty">Our gift boxes are being finished. Please check back very soon.</p>
    {%- else -%}

    <div class="amgb-layout">
      <div class="amgb-steps">

        {%- comment -%} STEP 1: BOX {%- endcomment -%}
        <div class="amgb-step">
          <h3 class="amgb-step__title"><span>1</span>Choose your box</h3>
          <p class="amgb-step__sub">Each box arrives gift-ready, with one piece of jewellery of your choice.</p>
          <div class="amgb-boxes">
            {%- for block in section.blocks -%}
              {%- if block.type == 'box' and block.settings.product != blank -%}
                {%- liquid
                  assign bp = block.settings.product
                  assign bv = bp.selected_or_first_available_variant
                  assign ref = block.settings.included_value | times: 100 | round
                  assign btitle = block.settings.title | default: bp.title
                  assign bimg = block.settings.image | default: bp.featured_image
                -%}
                <label class="amgb-box {% unless bp.available %}is-soldout{% endunless %}" data-index="{{ block.id }}" data-title="{{ btitle | escape }}" data-ref="{{ ref }}" data-variant="{{ bv.id }}" data-price="{{ bv.price }}" {{ block.shopify_attributes }}>
                  <input type="radio" name="amgb-box-{{ section.id }}" value="{{ block.id }}" class="amgb-visually" {% if block.id == first_box and bp.available %}checked{% endif %} {% unless bp.available %}disabled{% endunless %}>
                  <span class="amgb-box__inner">
                    {%- if bimg != blank -%}
                      <span class="amgb-box__img">{{ bimg | image_url: width: 800 | image_tag: loading: 'lazy', alt: btitle }}</span>
                    {%- endif -%}
                    <span class="amgb-box__body">
                      <span class="amgb-box__title">{{ btitle }}</span>
                      {%- if block.settings.description != blank -%}<span class="amgb-box__desc">{{ block.settings.description }}</span>{%- endif -%}
                      <span class="amgb-box__price">{% if bp.available %}{{ bv.price | plus: ref | money }}{% else %}Sold out{% endif %}</span>
                    </span>
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- for block in section.blocks -%}
            {%- if block.type == 'box' and block.settings.product != blank -%}
              {%- assign bp = block.settings.product -%}
              {%- if bp.has_only_default_variant == false -%}
                <div class="amgb-boxopt" data-index="{{ block.id }}" hidden>
                  <label for="amgb-boxsel-{{ block.id }}">{{ bp.options | join: ' / ' }}</label>
                  <select id="amgb-boxsel-{{ block.id }}" class="amgb-boxsel">
                    {%- for v in bp.variants -%}
                      <option value="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ v.title | escape }}" {% unless v.available %}disabled{% endunless %} {% if v.id == bp.selected_or_first_available_variant.id %}selected{% endif %}>{{ v.title }}{% unless v.available %} (sold out){% endunless %}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} STEP 2: JEWELLERY {%- endcomment -%}
        <div class="amgb-step">
          <h3 class="amgb-step__title"><span>2</span>Choose your jewellery</h3>
          <p class="amgb-step__sub">One piece is included in your box. Pick the one you would wear most.</p>
          <div class="amgb-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'jewellery' and block.settings.tier == 'included' and block.settings.product != blank -%}
                {%- liquid
                  assign jp = block.settings.product
                  assign jv = jp.selected_or_first_available_variant
                  assign jname = block.settings.name | default: jp.title
                  assign jimg = block.settings.image | default: jp.featured_image
                -%}
                <label class="amgb-card {% unless jp.available %}is-soldout{% endunless %}" data-tier="included" data-name="{{ jname | escape }}" data-variant="{{ jv.id }}" data-price="{{ jv.price }}" {{ block.shopify_attributes }}>
                  <input type="radio" name="amgb-jewel-{{ section.id }}" value="{{ block.id }}" class="amgb-visually" {% unless jp.available %}disabled{% endunless %}>
                  <span class="amgb-card__inner">
                    {%- if jimg != blank -%}<span class="amgb-card__img">{{ jimg | image_url: width: 600 | image_tag: loading: 'lazy', alt: jname }}</span>{%- endif -%}
                    <span class="amgb-card__body">
                      <span class="amgb-card__name">{{ jname }}</span>
                      <span class="amgb-card__tag">{% if jp.available %}Included{% else %}Sold out{% endif %}</span>
                      {%- if jp.has_only_default_variant == false and jp.available -%}
                        <select class="amgb-jsel" aria-label="{{ jp.options | join: ' / ' }}">
                          {%- for v in jp.variants -%}
                            <option value="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ v.title | escape }}" {% unless v.available %}disabled{% endunless %} {% if v.id == jv.id %}selected{% endif %}>{{ v.title }}{% unless v.available %} (sold out){% endunless %}</option>
                          {%- endfor -%}
                        </select>
                      {%- endif -%}
                    </span>
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if has_upgrades -%}
            <button type="button" class="amgb-upgrade-toggle" id="amgb-upgrade-toggle-{{ section.id }}" aria-expanded="false" aria-controls="amgb-upgrade-{{ section.id }}">Upgrade your jewellery</button>
            <div class="amgb-upgrade" id="amgb-upgrade-{{ section.id }}" hidden>
              <p class="amgb-upgrade__sub">Choose one of these instead. You pay only the difference.</p>
              <div class="amgb-grid">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'jewellery' and block.settings.tier == 'upgrade' and block.settings.product != blank -%}
                    {%- liquid
                      assign jp = block.settings.product
                      assign jv = jp.selected_or_first_available_variant
                      assign jname = block.settings.name | default: jp.title
                      assign jimg = block.settings.image | default: jp.featured_image
                    -%}
                    <label class="amgb-card {% unless jp.available %}is-soldout{% endunless %}" data-tier="upgrade" data-name="{{ jname | escape }}" data-variant="{{ jv.id }}" data-price="{{ jv.price }}" {{ block.shopify_attributes }}>
                      <input type="radio" name="amgb-jewel-{{ section.id }}" value="{{ block.id }}" class="amgb-visually" {% unless jp.available %}disabled{% endunless %}>
                      <span class="amgb-card__inner">
                        {%- if jimg != blank -%}<span class="amgb-card__img">{{ jimg | image_url: width: 600 | image_tag: loading: 'lazy', alt: jname }}</span>{%- endif -%}
                        <span class="amgb-card__body">
                          <span class="amgb-card__name">{{ jname }}</span>
                          <span class="amgb-card__tag">{% if jp.available %}Upgrade{% else %}Sold out{% endif %}</span>
                          {%- if jp.has_only_default_variant == false and jp.available -%}
                            <select class="amgb-jsel" aria-label="{{ jp.options | join: ' / ' }}">
                              {%- for v in jp.variants -%}
                                <option value="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ v.title | escape }}" {% unless v.available %}disabled{% endunless %} {% if v.id == jv.id %}selected{% endif %}>{{ v.title }}{% unless v.available %} (sold out){% endunless %}</option>
                              {%- endfor -%}
                            </select>
                          {%- endif -%}
                        </span>
                      </span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} STEP 3: EXTRAS {%- endcomment -%}
        {%- if has_extras -%}
          <div class="amgb-step">
            <h3 class="amgb-step__title"><span>3</span>Add a little extra</h3>
            <p class="amgb-step__sub">Optional.</p>
            <div class="amgb-extras">
              {%- for block in section.blocks -%}
                {%- if block.type == 'extra' and block.settings.product != blank -%}
                  {%- liquid
                    assign ep = block.settings.product
                    assign ev = ep.selected_or_first_available_variant
                    assign ename = block.settings.name | default: ep.title
                    assign eimg = block.settings.image | default: ep.featured_image
                  -%}
                  <label class="amgb-extra {% unless ep.available %}is-soldout{% endunless %}" data-name="{{ ename | escape }}" data-variant="{{ ev.id }}" data-price="{{ ev.price }}" {{ block.shopify_attributes }}>
                    <input type="checkbox" class="amgb-visually" {% unless ep.available %}disabled{% endunless %}>
                    <span class="amgb-extra__inner">
                      {%- if eimg != blank -%}<span class="amgb-extra__img">{{ eimg | image_url: width: 160 | image_tag: loading: 'lazy', alt: ename }}</span>{%- endif -%}
                      <span class="amgb-extra__text">
                        <span class="amgb-extra__name">{{ ename }}</span>
                        <span class="amgb-extra__price">{% if ep.available %}+ {{ ev.price | money }}{% else %}Sold out{% endif %}</span>
                      </span>
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} STEP 4: MESSAGE {%- endcomment -%}
        <div class="amgb-step">
          <h3 class="amgb-step__title"><span>{% if has_extras %}4{% else %}3{% endif %}</span>Add a gift message</h3>
          <p class="amgb-step__sub">{{ section.settings.message_help }}</p>
          <textarea id="amgb-msg-{{ section.id }}" maxlength="200" aria-label="Gift message" placeholder="{{ section.settings.message_placeholder | escape }}"></textarea>
        </div>
      </div>

      <aside class="amgb-summary" aria-live="polite">
        <h3 class="amgb-summary__title">Your gift box</h3>
        <ul class="amgb-lines" id="amgb-lines-{{ section.id }}"></ul>
        <div class="amgb-total"><span>Total</span><strong id="amgb-total-{{ section.id }}"></strong></div>
        <button type="button" class="amgb-btn" id="amgb-add-{{ section.id }}" disabled>{{ section.settings.button_label }}</button>
        <p class="amgb-hint" id="amgb-hint-{{ section.id }}">Choose your jewellery to continue</p>
        <p class="amgb-error" id="amgb-error-{{ section.id }}" role="alert" hidden></p>
        {%- if section.settings.reassurance != blank -%}<p class="amgb-reassure">{{ section.settings.reassurance }}</p>{%- endif -%}
      </aside>
    </div>
    {%- endif -%}
  </div>
</section>

{%- if box_count > 0 -%}
<script>
(function () {
  var root = document.getElementById('amgb-{{ section.id }}');
  if (!root) return;
  var currency = {{ cart.currency.iso_code | json }};
  var fmt = new Intl.NumberFormat('en-GB', { style: 'currency', currency: currency });
  function money(c) { return fmt.format(c / 100).replace(/\.00$/, ''); }

  var boxes = [].slice.call(root.querySelectorAll('.amgb-box'));
  var cards = [].slice.call(root.querySelectorAll('.amgb-card'));
  var extras = [].slice.call(root.querySelectorAll('.amgb-extra'));
  var panels = [].slice.call(root.querySelectorAll('.amgb-boxopt'));
  var linesEl = document.getElementById('amgb-lines-{{ section.id }}');
  var totalEl = document.getElementById('amgb-total-{{ section.id }}');
  var btn = document.getElementById('amgb-add-{{ section.id }}');
  var hint = document.getElementById('amgb-hint-{{ section.id }}');
  var errEl = document.getElementById('amgb-error-{{ section.id }}');
  var msg = document.getElementById('amgb-msg-{{ section.id }}');
  var toggle = document.getElementById('amgb-upgrade-toggle-{{ section.id }}');
  var upPanel = document.getElementById('amgb-upgrade-{{ section.id }}');
  var checked = function (el) { return el.querySelector('input').checked; };

  if (toggle && upPanel) {
    toggle.addEventListener('click', function () {
      var open = upPanel.hidden;
      upPanel.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  function boxVar(el) {
    var sel = root.querySelector('.amgb-boxopt[data-index="' + el.dataset.index + '"] select');
    if (sel && sel.selectedOptions.length) {
      var o = sel.selectedOptions[0];
      return { id: o.value, price: +o.dataset.price, title: o.dataset.title };
    }
    return { id: el.dataset.variant, price: +el.dataset.price, title: '' };
  }
  function itemVar(el) {
    var s = el.querySelector('select');
    if (s && s.selectedOptions.length) {
      var o = s.selectedOptions[0];
      return { id: o.value, price: +o.dataset.price, title: o.dataset.title };
    }
    return { id: el.dataset.variant, price: +el.dataset.price, title: '' };
  }
  function li(label, price) {
    var row = document.createElement('li');
    var a = document.createElement('span'); a.textContent = label;
    var b = document.createElement('span'); b.textContent = price;
    row.appendChild(a); row.appendChild(b);
    linesEl.appendChild(row);
  }

  function update() {
    var box = boxes.filter(checked)[0];
    var jewel = cards.filter(checked)[0];
    var ref = box ? +box.dataset.ref : 0;

    // keep the upgrade panel open if an upgrade piece is chosen
    if (jewel && jewel.dataset.tier === 'upgrade' && upPanel && upPanel.hidden) {
      upPanel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }

    panels.forEach(function (p) { p.hidden = !(box && p.dataset.index === box.dataset.index); });
    boxes.forEach(function (el) {
      if (el.classList.contains('is-soldout')) return;
      el.querySelector('.amgb-box__price').textContent = money(boxVar(el).price + (+el.dataset.ref));
    });
    cards.forEach(function (c) {
      if (c.classList.contains('is-soldout') || c.dataset.tier !== 'upgrade') return;
      var delta = itemVar(c).price - ref;
      c.querySelector('.amgb-card__tag').textContent = delta > 0 ? '+ ' + money(delta) + ' upgrade' : 'Upgrade';
    });

    linesEl.innerHTML = '';
    var total = 0;
    if (box) {
      var bv = boxVar(box);
      var boxName = box.dataset.title + (bv.title ? ' (' + bv.title + ')' : '');
      if (jewel) {
        var jv = itemVar(jewel);
        var jname = jewel.dataset.name + (jv.title ? ' (' + jv.title + ')' : '');
        if (jewel.dataset.tier === 'included') {
          li(boxName + ', with ' + jname, money(bv.price + jv.price));
        } else {
          li(boxName, money(bv.price + ref));
          var d = jv.price - ref;
          li('Upgrade to ' + jname, (d < 0 ? '- ' : '+ ') + money(Math.abs(d)));
        }
        total += bv.price + jv.price;
      } else {
        li(boxName, money(bv.price + ref));
        total += bv.price + ref;
      }
    }
    extras.forEach(function (e) {
      if (checked(e)) { var ev = itemVar(e); li(e.dataset.name, '+ ' + money(ev.price)); total += ev.price; }
    });
    totalEl.textContent = money(total);

    var ready = !!(box && jewel);
    btn.disabled = !ready;
    hint.textContent = ready ? '' : (box ? 'Choose your jewellery to continue' : 'Choose a box to continue');
  }

  root.addEventListener('change', update);
  root.addEventListener('input', update);

  btn.addEventListener('click', function () {
    var box = boxes.filter(checked)[0];
    var jewel = cards.filter(checked)[0];
    if (!box || !jewel) return;
    errEl.hidden = true;
    btn.disabled = true;
    var original = btn.textContent;
    btn.textContent = 'Adding\u2026';

    var bv = boxVar(box), jv = itemVar(jewel);
    var boxName = box.dataset.title;
    var boxProps = { 'Jewellery choice': jewel.dataset.name };
    var note = (msg.value || '').trim();
    if (note) boxProps['Gift message'] = note;

    var items = [
      { id: +bv.id, quantity: 1, properties: boxProps },
      { id: +jv.id, quantity: 1, properties: { 'Part of': boxName } }
    ];
    extras.forEach(function (e) {
      if (checked(e)) items.push({ id: +itemVar(e).id, quantity: 1, properties: { 'Part of': boxName } });
    });

    fetch({{ routes.cart_add_url | append: '.js' | json }}, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
    .then(function (res) {
      if (!res.ok) throw new Error(res.data.description || res.data.message || 'Something went wrong.');
      window.location.href = {{ routes.cart_url | json }};
    })
    .catch(function (e) {
      errEl.textContent = e.message + ' Nothing has been charged. Please adjust your choice or contact us.';
      errEl.hidden = false;
      btn.textContent = original;
      update();
    });
  });

  update();
})();
</script>
{%- endif -%}

