    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Contemporary jewellery, soft cashmere and everyday luxuries, personally curated by Nat at The Style Chapter and Atelier Modernista." },

    { "type": "header", "content": "Message, button and reassurance" },
    { "type": "text", "id": "message_help", "label": "Message helper text", "default": "A short note, written by hand on the card inside." },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "With love, for you…" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add gift box to bag" },
    { "type": "text", "id": "reassurance", "label": "Reassurance line", "default": "Arrives gift-ready. Dispatched within 1 working day." },

    { "type": "header", "content": "Spacing" },
