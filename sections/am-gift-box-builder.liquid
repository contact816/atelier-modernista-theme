      "settings": [
        { "type": "product", "id": "product", "label": "Extra product" },
        { "type": "text", "id": "name", "label": "Display name (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "AM Gift Box Builder",
      "blocks": [
        { "type": "box", "settings": { "title": "The Scarf Box", "description": "A wool-blend scarf and your choice of jewellery, presented ready to give.", "included_value": 20 } },
        { "type": "box", "settings": { "title": "The Little Luxury Box", "description": "Cashmere socks and your choice of jewellery, presented ready to give.", "included_value": 20 } },
        { "type": "box", "settings": { "title": "The Luxury Colour Edit", "description": "A wool scarf, a candle, hand cream and your choice of jewellery.", "included_value": 20 } },
        { "type": "jewellery", "settings": { "tier": "included" } },
        { "type": "jewellery", "settings": { "tier": "included" } },
        { "type": "jewellery", "settings": { "tier": "included" } },
        { "type": "jewellery", "settings": { "tier": "included" } },
        { "type": "jewellery", "settings": { "tier": "upgrade" } },
        { "type": "jewellery", "settings": { "tier": "upgrade" } }
      ]
    }
  ]
}
