{{ 'am-giveaway.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign terms_url = section.settings.terms_url | default: '/pages/art-you-can-wear-giveaway-terms'
  assign form_id = section.settings.klaviyo_form_id | strip
-%}

<section
  class="am-giveaway"
  id="am-giveaway-{{ section.id }}"
  aria-labelledby="am-giveaway-title-{{ section.id }}"
>

  <div class="am-giveaway__shell">

    <!-- IMPORTANT GIVEAWAY INFORMATION -->
    <div class="am-giveaway__footer">

      <div class="am-giveaway__fact">
        <span>OPENS</span>
        <strong>3 AUGUST 2026</strong>
      </div>

      <div class="am-giveaway__fact">
        <span>CLOSES</span>
        <strong>23 AUGUST · 11:59 PM</strong>
      </div>

      <div class="am-giveaway__fact">
        <span>DRAW</span>
        <strong>24 AUGUST 2026</strong>
      </div>

      <div class="am-giveaway__terms">
        <a href="{{ terms_url }}">
          FULL GIVEAWAY TERMS
        </a>
      </div>

    </div>

    <div class="am-giveaway__main">

      <!-- LEFT SIDE -->
      <div class="am-giveaway__left">

        <div class="am-giveaway__intro">

          <p class="am-giveaway__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>

          <div class="am-giveaway__prize-stamp">
            <span>CHOOSE ANY PIECE</span>
            <span>UP TO</span>
            <strong>£100</strong>
          </div>

          <h1
            class="am-giveaway__title"
            id="am-giveaway-title-{{ section.id }}"
          >
            {{ section.settings.heading | escape }}
          </h1>

          <div class="am-giveaway__lede rte">
            {{ section.settings.intro }}
          </div>

          
            <a
              class="am-giveaway__button"
              href="#am-giveaway-entry-{{ section.id }}"
          >
            {{ section.settings.button_label | default: 'ENTER THE GIVEAWAY' | escape }}
          </a>

          <p class="am-giveaway__micro">
            Free entry · UK residents · 18+ · One entry per person
          </p>

          <p
            class="am-giveaway__countdown"
            data-am-countdown
            data-open="2026-08-03T00:00:00+01:00"
            data-close="2026-08-23T23:59:00+01:00"
            aria-live="polite"
          >
            <span class="am-giveaway__countdown-label">Closes in</span>
            <span class="am-giveaway__countdown-value">—</span>
          </p>
            <aclass="am-giveaway__social"
            href="https://www.instagram.com/ateliermodernista"
            target="_blank"
            rel="noopener"
          >
            <svg class="am-giveaway__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"/>
            </svg>
            <span>@ateliermodernista</span>
          </a>

        </div>

        <div class="am-giveaway__visual">

          {%- if section.settings.image != blank -%}

            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                class: 'am-giveaway__image',
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(min-width: 990px) 58vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: section.settings.image.alt
            }}

          {%- else -%}

            <div class="am-giveaway__image-placeholder">
              <span>ADD GIVEAWAY IMAGE</span>
            </div>

          {%- endif -%}

        </div>

      </div>

      <!-- RIGHT SIDE: KLAVIYO FORM -->
      <aside
        class="am-giveaway__entry"
        id="am-giveaway-entry-{{ section.id }}"
        aria-label="Giveaway entry form"
      >

        <div class="am-giveaway__form-wrap">

          <div class="am-giveaway__form">

            {%- if form_id != blank -%}

              <div class="klaviyo-form-{{ form_id | escape }}"></div>

            {%- else -%}

              <div class="am-giveaway__form-placeholder">

                <strong>Klaviyo form space</strong>

                <p>
                  Add your Klaviyo embed form ID in the Theme Editor.
                </p>

              </div>

            {%- endif -%}

          </div>

          <div class="am-giveaway__form-lock" data-am-form-lock hidden>
            <p data-am-form-lock-message></p>
          </div>

        </div>

        <p class="am-giveaway__privacy">
          We use your details to administer the draw.
          If you opt in, we’ll also send occasional Atelier Modernista emails.
          Unsubscribe any time.
          See our
          <a href="/pages/privacy-policy">Privacy Policy</a>.
        </p>

      </aside>

    </div>

  </div>

  <script>
  (function () {
    var root = document.querySelector('#am-giveaway-{{ section.id }}');
    if (!root) return;

    var countdownEl = root.querySelector('[data-am-countdown]');
    var lockEl = root.querySelector('[data-am-form-lock]');
    var formEl = root.querySelector('.am-giveaway__form');
    var lockMsgEl = lockEl ? lockEl.querySelector('[data-am-form-lock-message]') : null;
    if (!countdownEl) return;

    var openDate = new Date(countdownEl.dataset.open);
    var closeDate = new Date(countdownEl.dataset.close);
    var labelEl = countdownEl.querySelector('.am-giveaway__countdown-label');
    var valueEl = countdownEl.querySelector('.am-giveaway__countdown-value');

    function format(ms) {
      var totalMinutes = Math.floor(ms / 60000);
      var days = Math.floor(totalMinutes / 1440);
      var hours = Math.floor((totalMinutes % 1440) / 60);
      var minutes = totalMinutes % 60;
      if (days > 0) return days + 'd ' + hours + 'h ' + minutes + 'm';
      if (hours > 0) return hours + 'h ' + minutes + 'm';
      return minutes + 'm';
    }

    function setLock(isLocked, message) {
      if (!lockEl || !formEl) return;
      lockEl.hidden = !isLocked;
      formEl.classList.toggle('is-locked', isLocked);
      if (isLocked && lockMsgEl) lockMsgEl.textContent = message;
    }

    function tick() {
      var now = new Date();

      if (now < openDate) {
        labelEl.textContent = 'Opens in';
        valueEl.textContent = format(openDate - now);
        setLock(true, 'Entries open 3 August 2026.');
        return;
      }

      if (now < closeDate) {
        labelEl.textContent = 'Closes in';
        valueEl.textContent = format(closeDate - now);
        setLock(false, '');
        return;
      }

      labelEl.textContent = 'Entries closed';
      valueEl.textContent = '';
      setLock(true, 'Entries have closed. Thank you for your interest.');
    }

    tick();
    setInterval(tick, 60000);
  })();
  </script>

</section>

{% schema %}
{
  "name": "AM — Giveaway",
  "tag": "section",
  "class": "section-am-giveaway",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ATELIER MODERNISTA GIVEAWAY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Win the piece you love the most!"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>One winner can choose their favourite available Atelier Modernista piece of their choice, up to £100.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ENTER THE GIVEAWAY"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Giveaway image"
    },
    {
      "type": "text",
      "id": "klaviyo_form_id",
      "label": "Klaviyo embed form ID",
      "info": "Enter the six-character form ID only, for example AbC123."
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Full terms page"
    }
  ],
  "presets": [
    {
      "name": "AM — Giveaway"
    }
  ]
}
{% endschema %}