<style>
  .am-header-section {
    display: block !important;
    width: 100%;
    margin: 0 !important;
    padding: 0 !important;
  }

  .am-site-header,
  .am-site-header * {
    box-sizing: border-box;
  }

  .am-site-header {
    position: relative;
    z-index: 100;
    width: 100%;
    font-family: 'Jost', sans-serif;
  }

  /* ATELIER CIRCLE ANNOUNCEMENT */

  .am-site-header__announcement {
    padding: 10px 20px;
    color: #ffffff;
    background: #0047ab;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
  }

  .am-site-header__announcement a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* MAIN NAVIGATION */

  /*
    Desktop: [Instagram + menu] on the left, utilities on the right, one line.
    64px bar + 70px logo strip = 134px header (pb-hero's --am-hero-header-h).
  */
  .am-site-header__nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 24px;
    min-height: 64px;
    padding: 0 32px;
    align-items: center;
    background: #fdf6e3;
    border-bottom: 1px solid rgba(0, 71, 171, 0.18);
  }

  .am-site-header__desktop-menu {
    display: flex;
    min-width: 0;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    gap: 28px;
  }

  .am-site-header__mobile-logo {
    display: none;
  }

  .am-site-header__utilities {
    grid-column: 2;
    justify-self: end;
  }

  /*
    One font for every top-level item. The menu buttons (About Us, Collections)
    need !important: custom-modernista.css forces Jost onto every <button>.
  */
  .am-site-header__desktop-menu a,
  .am-site-header__menu-button,
  .am-site-header__utilities a {
    color: #111111;
    font-family: var(--font-heading-family, Georgia, serif) !important;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .am-site-header__desktop-menu a:hover,
  .am-site-header__menu-button:hover,
  .am-site-header__utilities a:hover {
    color: #0047ab;
  }

  .am-site-header__menu-button {
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .am-site-header__utilities {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* INSTAGRAM */

  .am-site-header__instagram {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: #111111;
    transition: color 0.2s ease;
  }

  .am-site-header__instagram:hover,
  .am-site-header__instagram:focus-visible {
    color: #0047ab;
  }

  .am-site-header__instagram svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .am-site-header__drawer-instagram {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .am-site-header__drawer-instagram svg {
    flex: none;
    width: 20px;
    height: 20px;
    transform: translateY(2px);
  }

  .am-site-header__mobile-cart {
    display: inline-flex;
    align-items: center;
  }

  .am-site-header__cart-count {
    display: inline-flex;
    width: 22px;
    height: 22px;
    margin-left: 5px;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: #0047ab;
    border-radius: 50%;
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    line-height: 1;
  }

  /* MOBILE HAMBURGER */

  .am-site-header__hamburger {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .am-site-header__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #111111;
  }

  /* LOGO */

      .am-site-header__mobile-logo {
    display: none;
  }

 /* COMPACT DESKTOP LOGO STRIP */

.am-site-header__logo-banner {
  display: flex;
  width: 100%;
  min-height: 0;
  height: auto;
  padding: 11px 28px;
  align-items: center;
  justify-content: center;
  background: #fdf6e3;
  text-decoration: none;
  line-height: 0;
}

.am-site-header__logo-banner img {
  display: block;
  width: auto;
  height: 48px;
  max-width: 80vw;
  margin: 0;
  padding: 0;
  object-fit: contain;
}

  .am-site-header__fallback-logo {
    color: #0047ab;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 2rem;
  }

  /* DRAWER */

  .am-site-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .am-site-header__overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  /* Dawn's base.css hides every empty div (div:empty); keep the backdrop in the layout */
  .am-site-header .am-site-header__overlay {
    display: block;
  }

  .am-site-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    display: flex;
    width: min(88vw, 360px);
    height: 100%;
    padding: 76px 28px 36px;
    flex-direction: column;
    overflow-y: auto;
    background: #ffffff;
    transform: translateX(-105%);
    transition: transform 0.3s ease;
  }

  .am-site-header__drawer.is-open {
    transform: translateX(0);
  }

  .am-site-header__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    padding: 8px;
    color: #111111;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .am-site-header__close svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .am-site-header__drawer-heading {
    margin: 20px 0 8px;
    padding-bottom: 8px;
    color: #0047ab;
    border-bottom: 1px solid #0047ab;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .am-site-header__drawer-link {
    display: block;
    padding: 8px 0;
    color: #111111;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 1.5rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .am-site-header__drawer-link:hover {
    color: #0047ab;
  }

  .am-site-header__drawer-divider {
    width: 100%;
    margin: 16px 0;
    border: 0;
    border-top: 1px solid rgba(0, 71, 171, 0.35);
  }

  /* SMALL DESKTOP (1024-1279px): tighter type so the menu stays on one line */

  @media screen and (min-width: 1024px) and (max-width: 1279px) {
    .am-site-header__nav {
      padding: 0 24px;
    }

    .am-site-header__desktop-menu {
      gap: 18px;
    }

    .am-site-header__utilities {
      gap: 18px;
    }

    .am-site-header__desktop-menu a,
    .am-site-header__menu-button,
    .am-site-header__utilities a {
      font-size: 15px;
      letter-spacing: 0.03em;
    }
  }

  /* TABLET (750-1023px): burger menu, utilities stay, logo strip stays */

  @media screen and (min-width: 750px) and (max-width: 1023px) {
    .am-site-header__nav {
      grid-template-columns: 44px minmax(0, 1fr) auto;
      padding: 0 24px;
    }

    .am-site-header__hamburger {
      display: flex;
      grid-column: 1;
      margin-left: -10px;
    }

    .am-site-header__desktop-menu {
      display: none;
    }

    .am-site-header__utilities {
      grid-column: 3;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    .am-site-header__announcement {
      padding: 8px 12px;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
    }

    .am-site-header__nav {
      display: grid !important;
      min-height: 66px;
      padding: 0 14px;
      grid-template-columns: 48px 1fr auto;
      gap: 10px;
    }

    .am-site-header__hamburger {
      display: flex !important;
    }

    .am-site-header__desktop-menu {
      display: none !important;
    }

    .am-site-header__mobile-logo {
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    .am-site-header__mobile-logo img {
      display: block;
      width: auto;
      max-width: 150px;
      height: 48px;
      object-fit: contain;
    }

    .am-site-header__utilities {
      grid-column: 3;
      gap: 0;
    }

    .am-site-header__utilities a:not(.am-site-header__mobile-cart) {
      display: none;
    }

    .am-site-header__mobile-cart {
      display: flex;
      align-items: center;
      font-size: 1.2rem !important;
      letter-spacing: 0.03em !important;
    }

    .am-site-header__logo-banner {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-site-header__drawer,
    .am-site-header__overlay {
      transition: none;
    }
  }
</style>

<section
  class="am-site-header"
  data-am-site-header="{{ section.id }}"
>
  {%- if section.settings.announcement_text != blank -%}
    <div class="am-site-header__announcement">
      {{ section.settings.announcement_text | escape }}

      {%- if section.settings.announcement_link != blank -%}
        <a href="{{ section.settings.announcement_link }}">
          {{ section.settings.announcement_link_label | escape }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <nav class="am-site-header__nav" aria-label="Main navigation">
    <button
      class="am-site-header__hamburger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="am-mobile-menu-{{ section.id }}"
      data-am-menu-open
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="am-site-header__desktop-menu">
      <a
        class="am-site-header__instagram"
        href="https://www.instagram.com/ateliermodernista/"
        target="_blank"
        rel="noopener"
        aria-label="Atelier Modernista on Instagram (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>

      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <button
            class="am-site-header__menu-button"
            type="button"
            data-am-menu-open
          >
            {{ link.title | escape }} ↓
          </button>
        {%- else -%}
          <a href="{{ link.url }}">
            {{ link.title | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <a
      class="am-site-header__mobile-logo"
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name | escape }}"
    >
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag:
            loading: 'eager',
            alt: shop.name
        }}
      {%- else -%}
        {{ shop.name | escape }}
      {%- endif -%}
    </a>

    <div class="am-site-header__utilities">
      <a href="{{ routes.search_url }}">Search</a>

      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
        Account
      </a>

      <a
        class="am-site-header__mobile-cart"
        href="{{ routes.cart_url }}"
      >
        Bag
        <span class="am-site-header__cart-count">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </nav>

  <a
    class="am-site-header__logo-banner"
    href="{{ routes.root_url }}"
    aria-label="{{ shop.name | escape }}"
  >
    {%- if section.settings.logo != blank -%}
      {{
        section.settings.logo
        | image_url: width: 600
        | image_tag:
          loading: 'eager',
          alt: shop.name
      }}
    {%- else -%}
      <span class="am-site-header__fallback-logo">
        {{ shop.name | escape }}
      </span>
    {%- endif -%}
  </a>

  {%- if section.settings.giveaway_show -%}
    {%- liquid
      if section.settings.giveaway_link != blank
        assign giveaway_tag = 'a'
      else
        assign giveaway_tag = 'div'
      endif
    -%}
    <{{ giveaway_tag }}
      class="am-mobile-giveaway"
      {% if giveaway_tag == 'a' %}href="{{ section.settings.giveaway_link }}"{% endif %}
    >
      {%- if section.settings.giveaway_line_1 != blank -%}
        <span class="am-mobile-giveaway__line">{{ section.settings.giveaway_line_1 | escape }}</span>
      {%- endif -%}
      {%- if section.settings.giveaway_main != blank -%}
        <strong class="am-mobile-giveaway__main">{{ section.settings.giveaway_main | escape }}</strong>
      {%- endif -%}
      {%- if section.settings.giveaway_line_3 != blank -%}
        <span class="am-mobile-giveaway__line">{{ section.settings.giveaway_line_3 | escape }}</span>
      {%- endif -%}
    </{{ giveaway_tag }}>
  {%- endif -%}
  
    <div
    class="am-site-header__overlay"
    data-am-menu-overlay
    aria-hidden="true"
  ></div>

  <aside
    class="am-site-header__drawer"
    id="am-mobile-menu-{{ section.id }}"
    data-am-menu-drawer
    aria-label="Site menu"
    aria-hidden="true"
  >
    <button
      class="am-site-header__close"
      type="button"
      aria-label="Close menu"
      data-am-menu-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    {%- for link in section.settings.menu.links -%}
      {%- if link.links != blank -%}
        <p class="am-site-header__drawer-heading">
          {{ link.title | escape }}
        </p>

        {%- for childlink in link.links -%}
          <a
            class="am-site-header__drawer-link"
            href="{{ childlink.url }}"
          >
            {{ childlink.title | escape }}
          </a>

          {%- if childlink.links != blank -%}
            {%- for grandchildlink in childlink.links -%}
              <a
                class="am-site-header__drawer-link"
                href="{{ grandchildlink.url }}"
                style="padding-left: 1rem; font-size: 1.25rem;"
              >
                {{ grandchildlink.title | escape }}
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}

        <hr class="am-site-header__drawer-divider">
      {%- else -%}
        <a
          class="am-site-header__drawer-link"
          href="{{ link.url }}"
        >
          {{ link.title | escape }}
        </a>
      {%- endif -%}
    {%- endfor -%}

    <hr class="am-site-header__drawer-divider">

    <a
      class="am-site-header__drawer-link"
      href="{{ routes.search_url }}"
    >
      Search
    </a>

    <a
      class="am-site-header__drawer-link"
      href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
    >
      {% if customer %}
        My account
      {% else %}
        Sign in
      {% endif %}
    </a>

    <a
      class="am-site-header__drawer-link"
      href="{{ routes.cart_url }}"
    >
      Bag ({{ cart.item_count }})
    </a>

    <a
      class="am-site-header__drawer-link am-site-header__drawer-instagram"
      href="https://www.instagram.com/ateliermodernista/"
      target="_blank"
      rel="noopener"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4.2"></circle>
        <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"></circle>
      </svg>
      Instagram
    </a>
  </aside>


</section>

<style>
  /*
    The AM Nav Bar replaces Dawn’s standard header.
    This hides only Dawn’s original header inside the same header group.
  */
  .shopify-section-group-header-group:has(.am-site-header) .header-wrapper {
    display: none !important;
  }
  /*
    GIVEAWAY BADGE
    Turned on from the customiser (AM Nav Bar > Giveaway badge). Fixed to the right edge:
    1200px and up just below the 134px header, 769-1199px bottom-right, 750-768px just below
    the header over the hero image, phones just below the 66px bar. Measured clear of the
    pb-hero headline and buttons from 360px to 1920px.
  */
  .am-mobile-giveaway {
    --am-giveaway-size: 120px;

    position: fixed;
    top: 150px;
    right: 20px;
    z-index: 1000;

    display: flex;
    width: var(--am-giveaway-size);
    height: var(--am-giveaway-size);
    padding: 12px;
    box-sizing: border-box;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;

    color: #ffffff;
    background: #0047ab;
    border: 3px solid #ffffff;
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(0, 71, 171, 0.28);

    line-height: 1.05;
    text-align: center;
    text-decoration: none;

    transform: rotate(6deg);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .am-mobile-giveaway__line {
    display: block;
    color: inherit;
    font-family: var(--am-sans, 'Jost', sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .am-mobile-giveaway__main {
    display: block;
    color: inherit;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  a.am-mobile-giveaway:hover,
  a.am-mobile-giveaway:focus-visible {
    color: #0047ab;
    background: #ffffff;
    border-color: #0047ab;
    outline: none;
    transform: rotate(8deg) scale(1.04);
  }

  /* Not on the giveaway page itself */
  body:has(.am-giveaway) .am-mobile-giveaway {
    display: none;
  }

  /*
    750-1199px: the hero headline runs almost to the right edge, so a badge at top: 150px
    would cover it. Dock it bottom-right instead, in the space under the hero text.
  */
  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .am-mobile-giveaway {
      top: auto;
      bottom: 24px;
    }
  }

  /* Tablets (750-1023px): smaller badge so it clears the stacked hero buttons */
  @media screen and (min-width: 750px) and (max-width: 1023px) {
    .am-mobile-giveaway {
      --am-giveaway-size: 96px;

      right: 12px;
      bottom: 16px;
      padding: 9px;
      gap: 2px;
    }

    .am-mobile-giveaway__line {
      font-size: 8px;
      letter-spacing: 0.08em;
    }

    .am-mobile-giveaway__main {
      font-size: 21px;
    }
  }

  /* 750-768px: the hero is stacked with full-width buttons, so sit over the image instead */
  @media screen and (min-width: 750px) and (max-width: 768px) {
    .am-mobile-giveaway {
      top: 146px;
      bottom: auto;
    }
  }

  /* PHONES: below the 66px bar */

  @media screen and (max-width: 749px) {
    .am-mobile-giveaway {
      --am-giveaway-size: 88px;

      top: 76px;
      right: 10px;
      padding: 8px;
      gap: 2px;
      border-width: 2px;
    }

    .am-mobile-giveaway__line {
      font-size: 8px;
      letter-spacing: 0.08em;
    }

    .am-mobile-giveaway__main {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-mobile-giveaway {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    var header = document.querySelector(
      '[data-am-site-header="{{ section.id }}"]'
    );

    if (!header || header.dataset.menuReady === 'true') return;

    header.dataset.menuReady = 'true';

    var drawer = header.querySelector('[data-am-menu-drawer]');
    var overlay = header.querySelector('[data-am-menu-overlay]');
    var openButtons = header.querySelectorAll('[data-am-menu-open]');
    var closeButton = header.querySelector('[data-am-menu-close]');

    if (!drawer || !overlay) return;

    function openMenu() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');

      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');

      openButtons.forEach(function (button) {
        button.setAttribute('aria-expanded', 'true');
      });

      document.body.style.overflow = 'hidden';

      if (closeButton) {
        closeButton.focus();
      }
    }

    function closeMenu() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');

      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');

      openButtons.forEach(function (button) {
        button.setAttribute('aria-expanded', 'false');
      });

      document.body.style.overflow = '';

      if (openButtons.length) {
        openButtons[0].focus();
      }
    }

    openButtons.forEach(function (button) {
      button.addEventListener('click', openMenu);
    });

    if (closeButton) {
      closeButton.addEventListener('click', closeMenu);
    }

    overlay.addEventListener('click', closeMenu);

    drawer.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (event) {
      if (
        event.key === 'Escape' &&
        drawer.classList.contains('is-open')
      ) {
        closeMenu();
      }
    });
  })();
</script>

