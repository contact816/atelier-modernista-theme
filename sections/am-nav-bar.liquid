<style>
  .am-header-section {
    display: block !important;
    width: 100%;
    margin: 0 !important;
    padding: 0 !important;
  }

  .am-site-header,
  .am-site-header * {
    box-sizing: border-box;
  }

  .am-site-header {
    position: relative;
    z-index: 100;
    width: 100%;
    font-family: 'Jost', sans-serif;
  }

  /* ATELIER CIRCLE ANNOUNCEMENT */

  .am-site-header__announcement {
    padding: 10px 20px;
    color: #ffffff;
    background: #0047ab;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
  }

  .am-site-header__announcement a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* MAIN NAVIGATION */

  .am-site-header__nav {
    display: flex;
    min-height: 68px;
    padding: 0 40px;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-bottom: 1px solid rgba(0, 71, 171, 0.18);
  }

  .am-site-header__desktop-menu {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .am-site-header__desktop-menu a,
  .am-site-header__menu-button,
  .am-site-header__utilities a {
    color: #111111;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .am-site-header__desktop-menu a:hover,
  .am-site-header__menu-button:hover,
  .am-site-header__utilities a:hover {
    color: #0047ab;
  }

  .am-site-header__menu-button {
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .am-site-header__utilities {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .am-site-header__cart-count {
    display: inline-flex;
    width: 22px;
    height: 22px;
    margin-left: 5px;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: #0047ab;
    border-radius: 50%;
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    line-height: 1;
  }

  /* MOBILE HAMBURGER */

  .am-site-header__hamburger {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .am-site-header__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #111111;
  }

  /* LOGO */

  .am-site-header__mobile-logo {
    display: none;
  }

  .am-site-header__logo-banner {
    display: flex;
    min-height: 210px;
    padding: 28px;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    text-decoration: none;
  }

  .am-site-header__logo-banner img {
    display: block;
    width: auto;
    height: 170px;
    object-fit: contain;
  }

  .am-site-header__fallback-logo {
    color: #0047ab;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 2rem;
  }

  /* DRAWER */

  .am-site-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .am-site-header__overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .am-site-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    display: flex;
    width: min(88vw, 360px);
    height: 100%;
    padding: 76px 28px 36px;
    flex-direction: column;
    overflow-y: auto;
    background: #ffffff;
    transform: translateX(-105%);
    transition: transform 0.3s ease;
  }

  .am-site-header__drawer.is-open {
    transform: translateX(0);
  }

  .am-site-header__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    padding: 8px;
    color: #111111;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .am-site-header__close svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .am-site-header__drawer-heading {
    margin: 20px 0 8px;
    padding-bottom: 8px;
    color: #0047ab;
    border-bottom: 1px solid #0047ab;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .am-site-header__drawer-link {
    display: block;
    padding: 8px 0;
    color: #111111;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 1.5rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .am-site-header__drawer-link:hover {
    color: #0047ab;
  }

  .am-site-header__drawer-divider {
    width: 100%;
    margin: 16px 0;
    border: 0;
    border-top: 1px solid rgba(0, 71, 171, 0.35);
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    .am-site-header__announcement {
      padding: 8px 12px;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
    }

    .am-site-header__nav {
      display: grid !important;
      min-height: 66px;
      padding: 0 14px;
      grid-template-columns: 48px 1fr auto;
      gap: 10px;
    }

    .am-site-header__hamburger {
      display: flex !important;
    }

    .am-site-header__desktop-menu {
      display: none !important;
    }

    .am-site-header__mobile-logo {
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    .am-site-header__mobile-logo img {
      display: block;
      width: auto;
      max-width: 150px;
      height: 48px;
      object-fit: contain;
    }

    .am-site-header__utilities {
      gap: 0;
    }

    .am-site-header__utilities a:not(.am-site-header__mobile-cart) {
      display: none;
    }

    .am-site-header__mobile-cart {
      display: flex;
      align-items: center;
      font-size: 1rem !important;
      letter-spacing: 0.03em !important;
    }

    .am-site-header__logo-banner {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-site-header__drawer,
    .am-site-header__overlay {
      transition: none;
    }
  }
</style>

<section
  class="am-site-header"
  data-am-site-header="{{ section.id }}"
>
  {%- if section.settings.announcement_text != blank -%}
    <div class="am-site-header__announcement">
      {{ section.settings.announcement_text | escape }}

      {%- if section.settings.announcement_link != blank -%}
        <a href="{{ section.settings.announcement_link }}">
          {{ section.settings.announcement_link_label | escape }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <nav class="am-site-header__nav" aria-label="Main navigation">
    <button
      class="am-site-header__hamburger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="am-mobile-menu-{{ section.id }}"
      data-am-menu-open
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="am-site-header__desktop-menu">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <button
            class="am-site-header__menu-button"
            type="button"
            data-am-menu-open
          >
            {{ link.title | escape }} ↓
          </button>
        {%- else -%}
          <a href="{{ link.url }}">
            {{ link.title | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <a
      class="am-site-header__mobile-logo"
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name | escape }}"
    >
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag:
            loading: 'eager',
            alt: shop.name
        }}
      {%- else -%}
        {{ shop.name | escape }}
      {%- endif -%}
    </a>

    <div class="am-site-header__utilities">
      <a href="{{ routes.search_url }}">Search</a>

      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
        Account
      </a>

      <a
        class="am-site-header__mobile-cart"
        href="{{ routes.cart_url }}"
      >
        Bag
        <span class="am-site-header__cart-count">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </nav>

  <a
    class="am-site-header__logo-banner"
    href="{{ routes.root_url }}"
    aria-label="{{ shop.name | escape }}"
  >
    {%- if section.settings.logo != blank -%}
      {{
        section.settings.logo
        | image_url: width: 600
        | image_tag:
          loading: 'eager',
          alt: shop.name
      }}
    {%- else -%}
      <span class="am-site-header__fallback-logo">
        {{ shop.name | escape }}
      </span>
    {%- endif -%}
  </a>
    <div
    class="am-site-header__overlay"
    data-am-menu-overlay
    aria-hidden="true"
  ></div>

  <aside
    class="am-site-header__drawer"
    id="am-mobile-menu-{{ section.id }}"
    data-am-menu-drawer
    aria-label="Site menu"
    aria-hidden="true"
  >
    <button
      class="am-site-header__close"
      type="button"
      aria-label="Close menu"
      data-am-menu-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    {%- for link in section.settings.menu.links -%}
      {%- if link.links != blank -%}
        <p class="am-site-header__drawer-heading">
          {{ link.title | escape }}
        </p>

        {%- for childlink in link.links -%}
          <a
            class="am-site-header__drawer-link"
            href="{{ childlink.url }}"
          >
            {{ childlink.title | escape }}
          </a>

          {%- if childlink.links != blank -%}
            {%- for grandchildlink in childlink.links -%}
              <a
                class="am-site-header__drawer-link"
                href="{{ grandchildlink.url }}"
                style="padding-left: 1rem; font-size: 1.25rem;"
              >
                {{ grandchildlink.title | escape }}
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}

        <hr class="am-site-header__drawer-divider">
      {%- else -%}
        <a
          class="am-site-header__drawer-link"
          href="{{ link.url }}"
        >
          {{ link.title | escape }}
        </a>
      {%- endif -%}
    {%- endfor -%}

    <hr class="am-site-header__drawer-divider">

    <a
      class="am-site-header__drawer-link"
      href="{{ routes.search_url }}"
    >
      Search
    </a>

    <a
      class="am-site-header__drawer-link"
      href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
    >
      {% if customer %}
        My account
      {% else %}
        Sign in
      {% endif %}
    </a>

    <a
      class="am-site-header__drawer-link"
      href="{{ routes.cart_url }}"
    >
      Bag ({{ cart.item_count }})
    </a>
  </aside>

  {%- unless request.path == '/pages/art-you-can-wear-giveaway' -%}
  <a
    class="am-mobile-giveaway"
    href="/pages/art-you-can-wear-giveaway"
    aria-label="Enter the Atelier Modernista giveaway"
  >
    <span>WIN ANY</span>
    <strong>PIECE UP<br>TO £100</strong>
    <span aria-hidden="true">→</span>
  </a>
{%- endunless -%}

</section>

<style>
  /*
    The AM Nav Bar replaces Dawn’s standard header.
    This hides only Dawn’s original header inside the same header group.
  */
  .shopify-section-group-header-group:has(.am-site-header) .header-wrapper {
    display: none !important;
  }
  /* MOBILE GIVEAWAY BUTTON */

.am-mobile-giveaway {
  display: none;
}

@media screen and (max-width: 749px) {
  .am-mobile-giveaway {
    position: fixed;
    top: 124px;
    right: 10px;
    z-index: 90;

    display: flex;
    width: 92px;
    height: 92px;
    padding: 10px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;

    color: #ffffff;
    background: #0047ab;
    border: 3px solid #ffffff;
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(0, 71, 171, 0.28);

    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;

    transform: rotate(6deg);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .am-mobile-giveaway strong {
    color: inherit;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.05;
  }

  .am-mobile-giveaway:active,
  .am-mobile-giveaway:focus-visible {
    color: #0047ab;
    background: #ffffff;
    border-color: #0047ab;
    outline: none;
    transform: rotate(8deg) scale(1.04);
  }
}

@media (prefers-reduced-motion: reduce) {
  .am-mobile-giveaway {
    transition: none;
  }
}
</style>

<script>
  (function () {
    var header = document.querySelector(
      '[data-am-site-header="{{ section.id }}"]'
    );

    if (!header || header.dataset.menuReady === 'true') return;

    header.dataset.menuReady = 'true';

    var drawer = header.querySelector('[data-am-menu-drawer]');
    var overlay = header.querySelector('[data-am-menu-overlay]');
    var openButtons = header.querySelectorAll('[data-am-menu-open]');
    var closeButton = header.querySelector('[data-am-menu-close]');

    if (!drawer || !overlay) return;

    function openMenu() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');

      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');

      openButtons.forEach(function (button) {
        button.setAttribute('aria-expanded', 'true');
      });

      document.body.style.overflow = 'hidden';

      if (closeButton) {
        closeButton.focus();
      }
    }

    function closeMenu() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');

      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');

      openButtons.forEach(function (button) {
        button.setAttribute('aria-expanded', 'false');
      });

      document.body.style.overflow = '';

      if (openButtons.length) {
        openButtons[0].focus();
      }
    }

    openButtons.forEach(function (button) {
      button.addEventListener('click', openMenu);
    });

    if (closeButton) {
      closeButton.addEventListener('click', closeMenu);
    }

    overlay.addEventListener('click', closeMenu);

    drawer.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (event) {
      if (
        event.key === 'Escape' &&
        drawer.classList.contains('is-open')
      ) {
        closeMenu();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "AM Nav Bar",
  "tag": "section",
  "class": "section am-header-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "FREE UK DELIVERY FOR ATELIER CIRCLE MEMBERS ·"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement link label",
      "default": "JOIN HERE"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "AM Nav Bar"
    }
  ]
}
{% endschema %}