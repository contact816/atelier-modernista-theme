{%- style -%}
  .am-gift-guide-hub {
    max-width: 900px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }
  .am-gift-guide-hub__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    color: #1a1a18;
    margin: 0 0 16px;
  }
  .am-gift-guide-hub__intro {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(26, 26, 24, 0.75);
    max-width: 60ch;
    margin: 0 0 48px;
  }
  .am-gift-guide-hub__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .am-gift-guide-hub__card {
    display: block;
    border: 1px solid rgba(26, 26, 24, 0.12);
    text-decoration: none;
  }
  .am-gift-guide-hub__card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #e8e2d4;
  }
  .am-gift-guide-hub__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .am-gift-guide-hub__card-body {
    padding: 20px;
  }
  .am-gift-guide-hub__card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 400;
    color: #1a1a18;
    margin: 0 0 8px;
  }
  .am-gift-guide-hub__card-description {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(26, 26, 24, 0.7);
    margin: 0;
  }
{%- endstyle -%}

<div class="am-gift-guide-hub">
  <h1 class="am-gift-guide-hub__heading">{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.intro != blank -%}
    <div class="am-gift-guide-hub__intro">{{ section.settings.intro }}</div>
  {%- endif -%}

  <ul class="am-gift-guide-hub__list" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'guide' -%}
        <li {{ block.shopify_attributes }}>
          <a class="am-gift-guide-hub__card" href="{{ block.settings.link }}">
            {%- if block.settings.image != blank -%}
              <div class="am-gift-guide-hub__card-image">
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | escape | default: block.settings.title }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </div>
            {%- endif -%}
            <div class="am-gift-guide-hub__card-body">
              <h2 class="am-gift-guide-hub__card-title">{{ block.settings.title | escape }}</h2>
              {%- if block.settings.description != blank -%}
                <p class="am-gift-guide-hub__card-description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "AM — Gift Guide Hub",
  "tag": "section",
  "class": "am-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift Guides"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Curated edits, built around a theme, each linking through to the full piece."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to guide page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AM — Gift Guide Hub",
      "blocks": [
        { "type": "guide" },
        { "type": "guide" }
      ]
    }
  ]
}
{% endschema %}
