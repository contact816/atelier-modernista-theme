{%- style -%}
  .am-gift-guide {
    max-width: 1100px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }
  .am-gift-guide__back {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: rgba(26, 26, 24, 0.6);
    text-decoration: none;
    margin-bottom: 24px;
  }
  .am-gift-guide__back:hover {
    color: #0047AB;
  }
  .am-gift-guide__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    color: #1a1a18;
    margin: 0 0 16px;
  }
  .am-gift-guide__intro,
  .am-gift-guide__christmas-intro {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(26, 26, 24, 0.75);
    max-width: 65ch;
    margin: 0 0 20px;
  }
  .am-gift-guide__notices {
    max-width: 65ch;
    margin: 0 0 48px;
    padding-top: 20px;
    border-top: 1px solid rgba(26, 26, 24, 0.12);
  }
  .am-gift-guide__notice {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(26, 26, 24, 0.65);
    margin: 0 0 8px;
  }
  .am-gift-guide__notice:last-child {
    margin-bottom: 0;
  }
  .am-gift-guide__notice a {
    color: #0047AB;
    text-decoration: underline;
  }
  .am-gift-guide__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .am-gift-guide__item {
    display: block;
    text-decoration: none;
  }
  .am-gift-guide__item-image {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #e8e2d4;
    margin-bottom: 16px;
  }
  .am-gift-guide__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .am-gift-guide__item-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 19px;
    font-weight: 400;
    color: #1a1a18;
    margin: 0 0 6px;
  }
  .am-gift-guide__item-price {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #1a1a18;
    margin: 0;
  }
  .am-gift-guide__empty {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    color: rgba(26, 26, 24, 0.55);
    font-style: italic;
  }
{%- endstyle -%}

{%- liquid
  assign source = collections[section.settings.source_collection]
  assign max_products = section.settings.max_products
  assign shown = 0
-%}

<div class="am-gift-guide">
  {%- if section.settings.hub_link_url != blank -%}
    <a class="am-gift-guide__back" href="{{ section.settings.hub_link_url }}">
      {{ section.settings.hub_link_label | default: '← Back to Gift Guides' }}
    </a>
  {%- endif -%}

  <h1 class="am-gift-guide__heading">{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.intro != blank -%}
    <div class="am-gift-guide__intro">{{ section.settings.intro }}</div>
  {%- endif -%}
  {%- if section.settings.christmas_intro != blank -%}
    <div class="am-gift-guide__christmas-intro">{{ section.settings.christmas_intro }}</div>
  {%- endif -%}

  {%- if section.settings.delivery_line != blank or section.settings.gift_wrap_line != blank -%}
    <div class="am-gift-guide__notices">
      {%- if section.settings.delivery_line != blank -%}
        <p class="am-gift-guide__notice">{{ section.settings.delivery_line }}</p>
      {%- endif -%}
      {%- if section.settings.gift_wrap_line != blank -%}
        <p class="am-gift-guide__notice">
          {{ section.settings.gift_wrap_line }}
          {%- if section.settings.gift_wrap_url != blank -%}
            <a href="{{ section.settings.gift_wrap_url }}">{{ section.settings.gift_wrap_link_label | default: 'Details' }}</a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if source != blank -%}
    <ul class="am-gift-guide__list" role="list">
      {%- for product in source.products -%}
        {%- assign include_product = true -%}
        {%- if section.settings.filter_by_color and section.settings.color_metaobject_id != blank -%}
          {%- assign include_product = false -%}
          {%- assign color_refs = product.metafields.shopify['color-pattern'].value -%}
          {%- for color_ref in color_refs -%}
            {%- assign color_ref_id_string = color_ref.id | append: '' -%}
            {%- if color_ref_id_string contains section.settings.color_metaobject_id -%}
              {%- assign include_product = true -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if include_product and shown < max_products -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>
            <a class="am-gift-guide__item" href="{{ product.url }}">
              {%- if product.featured_media -%}
                <div class="am-gift-guide__item-image">
                  <img
                    src="{{ product.featured_media | image_url: width: 500 }}"
                    alt="{{ product.featured_media.alt | escape | default: product.title }}"
                    loading="lazy"
                    width="{{ product.featured_media.width }}"
                    height="{{ product.featured_media.height }}"
                  >
                </div>
              {%- endif -%}
              <h2 class="am-gift-guide__item-title">{{ product.title | escape }}</h2>
              <p class="am-gift-guide__item-price">{{ product.price | money }}</p>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if shown == 0 -%}
      <p class="am-gift-guide__empty">No products are currently assigned to this guide.</p>
    {%- endif -%}
  {%- else -%}
    <p class="am-gift-guide__empty">Source collection not found — check the collection handle in Theme Customiser.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AM — Gift Guide",
  "tag": "section",
  "class": "am-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "textarea",
      "id": "christmas_intro",
      "label": "Christmas framing line",
      "info": "Seasonal intro line, shown below the main intro."
    },
    {
      "type": "text",
      "id": "delivery_line",
      "label": "Delivery line"
    },
    {
      "type": "text",
      "id": "gift_wrap_line",
      "label": "Gift wrapping line"
    },
    {
      "type": "url",
      "id": "gift_wrap_url",
      "label": "Gift wrapping link URL"
    },
    {
      "type": "text",
      "id": "gift_wrap_link_label",
      "label": "Gift wrapping link label",
      "default": "Details"
    },
    {
      "type": "header",
      "content": "Product source"
    },
    {
      "type": "text",
      "id": "source_collection",
      "label": "Source collection handle",
      "info": "The collection to pull products from, e.g. \"miro\" or \"the-atelier-collection\"."
    },
    {
      "type": "checkbox",
      "id": "filter_by_color",
      "label": "Filter by Shopify colour metafield",
      "default": false
    },
    {
      "type": "text",
      "id": "color_metaobject_id",
      "label": "Colour metaobject ID",
      "info": "The numeric ID from the colour's metaobject GID, e.g. 307256230225 for Cobalt (see the Colour Edit section's swatch settings for reference IDs)."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products shown",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Hub link"
    },
    {
      "type": "text",
      "id": "hub_link_label",
      "label": "Hub link label",
      "default": "← Back to Gift Guides"
    },
    {
      "type": "url",
      "id": "hub_link_url",
      "label": "Hub link URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "AM — Gift Guide"
    }
  ]
}
{% endschema %}
