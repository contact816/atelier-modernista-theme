{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign am_fp_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign am_fp_count = am_fp_count | plus: 1
    endif
  endfor

  comment
    Carousel only when the setting is ticked AND there are 5+ products.
    With 4 or fewer, the section renders exactly as before.
  endcomment
  assign am_fp_carousel = false
  if section.settings.enable_carousel and am_fp_count > 4
    assign am_fp_carousel = true
  endif
-%}

{%- if am_fp_carousel -%}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div class="am-featured{% if am_fp_carousel %} am-featured--carousel{% endif %}">
  {%- if am_fp_carousel -%}<slider-component id="AmFeaturedSlider-{{ section.id }}" class="am-featured__slider">{%- endif -%}
  <div class="am-featured__head">
    <div class="am-featured__head-text">
      {%- if section.settings.eyebrow != blank -%}
        <div class="am-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="am-featured__heading">{{ section.settings.heading }}</h2>
    </div>
    {%- if am_fp_carousel -%}<div class="am-featured__head-actions">{%- endif -%}
    {%- if section.settings.view_all_label != blank -%}
      <a href="{{ section.settings.view_all_url }}" class="am-link-underline">{{ section.settings.view_all_label }} →</a>
    {%- endif -%}
    {%- if am_fp_carousel -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div
    class="am-product-grid am-product-grid--4{% if am_fp_carousel %} am-featured__track{% endif %}"
    {%- if am_fp_carousel %}
      id="Slider-{{ section.id }}"
      aria-label="{{ section.settings.heading | escape }}"
    {%- endif %}
  >
    {%- for block in section.blocks -%}
      {%- assign product = all_products[block.settings.product] -%}
      {%- if product != empty -%}
        <div
          class="am-product-card"
          {% if am_fp_carousel %}
            id="Slide-{{ section.id }}-{{ forloop.index }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <a href="{{ product.url }}" class="am-product-card__link">
            <div class="am-product-card__image">
              {%- if block.settings.badge != blank -%}
                <span class="am-tag{% if block.settings.badge_red %} am-tag--red{% endif %}">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="600">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'am-product-card__placeholder' }}
              {%- endif -%}
            </div>
            <div class="am-product-card__name" id="title-{{ section.id }}-{{ product.id }}">{{ product.title }}</div>
            <div class="am-product-card__meta">{{ product.metafields.custom.subtitle | default: product.type }}</div>
            <div class="am-product-card__price">{{ product.price | money }}</div>
          </a>

          {%- assign product_form_id = 'quick-add-' | append: section.id | append: product.id -%}
          {%- liquid
            assign qty_rules = false
            if product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null or product.selected_or_first_available_variant.quantity_rule.increment > 1
              assign qty_rules = true
            endif
          -%}
          <div class="quick-add no-js-hidden">
            {%- if product.variants_count > 1 or qty_rules -%}
              <modal-opener data-modal="#QuickAdd-{{ product.id }}">
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width button--secondary"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section.id }}-{{ product.id }}"
                  data-product-url="{{ product.url }}"
                >
                  {{ 'products.product.choose_options' | t }}
                  {%- render 'loading-spinner' -%}
                </button>
              </modal-opener>
              <quick-add-modal id="QuickAdd-{{ product.id }}" class="quick-add-modal">
                <div
                  role="dialog"
                  aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
                  aria-modal="true"
                  class="quick-add-modal__content global-settings-popup"
                  tabindex="-1"
                >
                  <button
                    id="ModalClose-{{ product.id }}"
                    type="button"
                    class="quick-add-modal__toggle"
                    aria-label="{{ 'accessibility.close' | t }}"
                  >
                    {{- 'icon-close.svg' | inline_asset_content -}}
                  </button>
                  <div id="QuickAddInfo-{{ product.id }}" class="quick-add-modal__content-info"></div>
                </div>
              </quick-add-modal>
            {%- else -%}
              <product-form data-section-id="{{ section.id }}">
                {%- form 'product',
                  product,
                  id: product_form_id,
                  class: 'form',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                    class="product-variant-id"
                    {% if product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit button button--full-width button--secondary"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section.id }}-{{ product.id }}"
                    aria-live="polite"
                    data-sold-out-message="true"
                    {% if product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    <span>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="sold-out-message hidden">
                      {{ 'products.product.sold_out' | t }}
                    </span>
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if am_fp_carousel -%}</slider-component>{%- endif -%}
</div>

{%- if am_fp_carousel -%}
  <script>
    // Card widths have sub-pixel fractions, so Dawn's end-of-row check can miss
    // by ~1px and the "next" arrow never fades. Allow 2px for this slider only.
    customElements.whenDefined('slider-component').then(() => {
      const slider = document.getElementById('AmFeaturedSlider-{{ section.id }}');
      if (!slider || !slider.isSlideVisible) return;
      const isSlideVisible = slider.isSlideVisible.bind(slider);
      slider.isSlideVisible = (element, offset = 0) => isSlideVisible(element, offset - 2);
      slider.update();
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "AM — Featured Products",
  "tag": "section",
  "class": "am-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This Season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces in colour, chosen with conviction." },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All Pieces" },
    { "type": "url", "id": "view_all_url", "label": "View all link" },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "info": "Turns on with 5 or more products. With 4 or fewer, the grid stays as it is.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge text (e.g. New, Bestseller)", "info": "Leave blank for no badge" },
        { "type": "checkbox", "id": "badge_red", "label": "Red badge text", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "AM — Featured Products",
      "blocks": [
        { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }
      ]
    }
  ]
}
{% endschema %}