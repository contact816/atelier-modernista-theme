{%- liquid
  # Desktop image is 4:5, width = min(708px, 0.527 x the row, height cap x 0.8).
  # Height cap = 100vh - 134px header - image top padding - 32px; 192px = the 240px height floor x 0.8.
  # Image top padding = text padding-top + 5px (eyebrow cap offset, rounded down so sizes never undershoot).
  # Screens taller than 860px: smallest is 60 + 5 = 65px (134 + 65 + 32 = 231).
  # Shorter screens use the tightened spacing: 32 + 5 = 37px (134 + 37 + 32 = 203).
  assign hero_cap_tall = 'max(192px, calc((100vh - 231px) * 0.8))'
  assign hero_cap_short = 'max(192px, calc((100vh - 203px) * 0.8))'
  assign hero_sizes = '(min-width: 1504px) and (min-height: 861px) min(708px, ' | append: hero_cap_tall | append: '), (min-width: 769px) and (min-height: 861px) min(calc(52.7vw - 85px), ' | append: hero_cap_tall | append: '), (min-width: 1504px) min(708px, ' | append: hero_cap_short | append: '), (min-width: 769px) min(calc(52.7vw - 85px), ' | append: hero_cap_short | append: '), (min-width: 1504px) 708px, (min-width: 769px) calc(52.7vw - 85px), calc(100vw - 32px)'
-%}
<div class="am-hero{% if section.settings.eyebrow != blank %} am-hero--has-eyebrow{% endif %}">
  <div class="am-hero__image">
    {%- if section.settings.hero_image != blank -%}
      <a href="{{ section.settings.primary_cta_url }}" class="am-hero__image-link" aria-label="{{ section.settings.primary_cta_label | default: 'Shop the collection' | escape }}">
        {%- comment -%} sizes: desktop image column = min(708px, (row - 64px gap) * 0.527, height cap x 0.8), row = min(100vw, 1504px) - 96px side padding; see hero_sizes. The min() entries come first; browsers that can't parse min() skip them and use the plain fallbacks. Mobile: 100vw - 32px {%- endcomment -%}
        {{
          section.settings.hero_image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: hero_sizes,
            width: section.settings.hero_image.width,
            height: section.settings.hero_image.height,
            loading: 'eager',
            fetchpriority: 'high',
            preload: true
        }}
      </a>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'am-hero__placeholder' }}
    {%- endif -%}
  </div>
  <div class="am-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <div class="am-hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
   <h1 class="am-hero__headline">
  {%- if section.settings.headline_plain != blank -%}{{ section.settings.headline_plain }}<br>{%- endif -%}
  {%- if section.settings.headline_italic != blank -%}<em>{{ section.settings.headline_italic }}</em>{%- endif -%}
</h1>
    {%- if section.settings.subheading != blank -%}
      <div class="am-hero__sub">{{ section.settings.subheading }}</div>
    {%- endif -%}
    <div class="am-hero__cta-row">
      <a href="{{ section.settings.primary_cta_url }}" class="am-btn-primary">
        {{ section.settings.primary_cta_label }}
      </a>
      {%- if section.settings.secondary_cta_label != blank -%}
        <a href="{{ section.settings.secondary_cta_url }}" class="am-btn-secondary">
          {{ section.settings.secondary_cta_label }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_trust_strip -%}
      <div class="am-hero__trust">
        <span><span class="am-dot"></span>{{ section.settings.trust_1 }}</span>
        <span><span class="am-dot"></span>{{ section.settings.trust_2 }}</span>
        <span><span class="am-dot"></span>{{ section.settings.trust_3 }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .am-hero {
    display: grid;

    /* Proportional 780:700 tracks that shrink to fit; max-width caps them at exactly 780px + 700px */
    grid-template-columns: minmax(0, 780fr) minmax(0, 700fr);

    justify-content: center;

    gap: 24px;

    max-width: 1504px;

    margin: 0 auto;

    min-height: 70vh;  
}

  .am-hero__image {
    position: relative;
    overflow: hidden;
    background-color: #fdf6e3 !important;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 60px 24px 24px 48px !important;

    box-sizing: border-box !important;
}

  .am-hero__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

.am-hero__image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.am-hero__image img {
    width: 100%;
    height: 100%;

    object-fit: scale-down;
object-position: center center;
}
  .am-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 40px 80px 80px 80px;

    transform: translateY(-40px);
}
  .am-hero .am-hero__content .am-hero__eyebrow {
    font-family: 'Jost', sans-serif !important;
    font-size: 11px !important;
    font-weight: 400 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: #0047AB !important;
    margin: 0 0 24px !important;
  }

  .am-hero .am-hero__content h1.am-hero__headline,
  .am-hero .am-hero__content .am-hero__headline {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(22px, 4.5vw, 42px) !important;
    font-weight: 400 !important;
    letter-spacing: -0.01em !important;
    line-height: 1.05 !important;
    color: #1a1a18 !important;
    margin: 0 0 28px !important;
    text-align: left !important;
}


  .am-hero .am-hero__content .am-hero__sub {
    font-family: 'Jost', sans-serif !important;
    font-size: 16px !important;
    font-weight: 300 !important;
    line-height: 1.75 !important;
    color: #3a3a35 !important;
    max-width: 480px !important;
    margin: 0 0 40px !important;
  }

  .am-hero .am-hero__content .am-hero__cta-row {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 16px !important;
    align-items: center !important;
    margin-bottom: 48px !important;
  }

  .am-hero .am-hero__content .am-btn-primary {
    display: inline-block !important;
    font-family: 'Jost', sans-serif !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    padding: 16px 38px !important;
    background-color: #0047AB !important;
    color: #fdf6e3 !important;
    border: 1px solid #0047AB !important;
    border-radius: 0 !important;
  }

  .am-hero .am-hero__content .am-btn-primary:hover {
    background-color: #1a1a18 !important;
    border-color: #1a1a18 !important;
    color: #fdf6e3 !important;
  }

  .am-hero .am-hero__content .am-btn-secondary {
    display: inline-block !important;
    font-family: 'Jost', sans-serif !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    padding: 4px 0 !important;
    background: transparent !important;
    color: #1a1a18 !important;
    border: none !important;
    border-bottom: 1px solid #1a1a18 !important;
    border-radius: 0 !important;
  }

  .am-hero .am-hero__content .am-btn-secondary:hover {
    color: #0047AB !important;
    border-color: #0047AB !important;
  }

  .am-hero .am-hero__content .am-hero__trust {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 6px 32px !important;
    padding-top: 28px !important;
    border-top: 1px solid rgba(26,26,24,0.1) !important;
    font-family: 'Jost', sans-serif !important;
    font-size: 11px !important;
    font-weight: 400 !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    color: #9e9a90 !important;
    margin-top: 0 !important;
  }

  .am-hero .am-hero__content .am-hero__trust span {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    color: #9e9a90 !important;
    font-size: 11px !important;
  }

  .am-hero .am-hero__content .am-dot {
    display: inline-block !important;
    width: 5px !important;
    height: 5px !important;
    border-radius: 50% !important;
    background-color: #0047AB !important;
    flex-shrink: 0 !important;
  }

  @media (max-width: 1024px) {
    .am-hero .am-hero__content {
      padding: 60px 40px !important;
    }
  }

  /*
    Layout-shift guard. pb-global.css and custom-modernista.css load after first paint
    (media="print" onload in theme.liquid), so anything they change moves the hero.
    These rules give the hero those final values from the first paint.
  */
  .am-hero {
    line-height: 1.65; /* custom-modernista.css body line-height, inherited by the eyebrow, buttons and trust strip */
  }
  .am-hero__image {
    min-height: 400px; /* pb-global.css */
  }
  .am-hero__image img {
    display: block;
    max-width: 100%;
  }

  /* Desktop: top of the image lines up with the top of the eyebrow's capital letters (optical),
     i.e. the top of the text block. Without an eyebrow it lines up with the top of the h1 box. */
  @media (min-width: 769px) {
    .am-hero {
      --am-hero-pad-top: 80px; /* wins from custom-modernista.css (.am-hero__content padding: 80px 5%) */
      --am-hero-eyebrow-lh: 18.15px; /* 11px x 1.65, the body line-height it inherits from custom-modernista.css */
      /* Gap from the top of the eyebrow's line box to the top of its capitals, from Jost's metrics
         (per em: ascender 1.070, descender 0.375, cap height 0.700): half-leading + (ascender - cap height).
         = (18.15 - 15.895) / 2 + 4.07 = 5.2px */
      --am-hero-eyebrow-cap: calc((var(--am-hero-eyebrow-lh) - 11px * 1.445) / 2 + 11px * 0.37);
      --am-hero-eyebrow-offset: 0px;
      --am-hero-img-top: calc(var(--am-hero-pad-top) + var(--am-hero-eyebrow-offset));
      --am-hero-header-h: 134px; /* measured: am-nav-bar 64px + logo strip 70px, 750px and up (the theme's --header-height of 140px is stale) */
      --am-hero-eyebrow-gap: 24px;
      /* Tallest the image may be so header + hero fit one screen (32px spare); 240px floor for very short windows */
      --am-hero-img-cap: max(240px, calc(100vh - var(--am-hero-header-h) - var(--am-hero-img-top) - 32px));
      align-content: center;
      /* Image column sized to the image itself (no dead cream beside it), fixed 64px gap, text
         column up to 620px; the pair is centred within the 1504px max-width. The 0.527 share keeps
         the old 780:700 split, and the height cap x 0.8 keeps the image 4:5 when the screen is short. */
      grid-template-columns: min(708px, calc((100% - 64px) * 0.527), calc(var(--am-hero-img-cap) * 0.8)) minmax(0, 620px);
      column-gap: 64px;
      justify-content: center;
      padding-left: 48px;
      padding-right: 48px;
    }
    .am-hero--has-eyebrow {
      --am-hero-eyebrow-offset: var(--am-hero-eyebrow-cap);
    }
    .am-hero .am-hero__content {
      justify-content: flex-start;
      padding-top: var(--am-hero-pad-top) !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      transform: none;
    }
    /* The eyebrow's first line sits at the top of the text column, so a wrapped eyebrow simply
       grows downward and the alignment holds. Line-height pinned to match --am-hero-eyebrow-cap. */
    .am-hero .am-hero__content .am-hero__eyebrow {
      line-height: var(--am-hero-eyebrow-lh) !important;
      margin-bottom: var(--am-hero-eyebrow-gap) !important;
    }
    .am-hero .am-hero__image {
      padding: var(--am-hero-img-top) 0 24px 0 !important;
    }
    /* Always 4:5, filling its column; the column width already respects the height cap. */
    .am-hero__image img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      margin: 0;
      object-fit: cover;
      object-position: center top;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .am-hero {
      --am-hero-pad-top: 60px; /* matches the 60px 40px padding above */
    }
  }

  /* Short desktop screens: tighten vertical spacing in the text column so it fits beside the
     image. Font sizes are unchanged. The image top still follows --am-hero-img-top. */
  @media (min-width: 769px) and (max-height: 860px) {
    .am-hero {
      --am-hero-pad-top: 32px;
      --am-hero-eyebrow-gap: 14px;
      min-height: 0; /* the 70vh minimum alone would push header + hero past the fold here */
    }
    .am-hero .am-hero__content {
      padding-bottom: 24px !important;
    }
    .am-hero .am-hero__content h1.am-hero__headline,
    .am-hero .am-hero__content .am-hero__headline {
      margin-bottom: 14px !important;
    }
    .am-hero .am-hero__content .am-hero__sub {
      margin-bottom: 18px !important;
    }
    .am-hero .am-hero__content .am-hero__cta-row {
      margin-bottom: 20px !important;
    }
    .am-hero .am-hero__content .am-hero__trust {
      padding-top: 14px !important;
    }
  }

  @media (max-width: 768px) {
    .am-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .am-hero__image {
      height: 60vw;
      min-height: 480px; /* pb-global.css sets this late; without it the image box jumps from 60vw to 480px (the CLS) */
      position: relative;
    }
    .am-hero__image {
      padding: 16px !important;
    }
    .am-hero__image img {
      position: static;
    }
    .am-hero .am-hero__content {
      padding: 48px 28px !important;
    }
    .am-hero .am-hero__content h1.am-hero__headline,
    .am-hero .am-hero__content .am-hero__headline {
      font-size: clamp(26px, 6vw, 36px) !important;
    }
    .am-hero .am-hero__content .am-btn-primary {
      width: 100% !important;
      text-align: center !important;
    }
  }
</style>

{% schema %}
{
  "name": "AM — Hero",
  "tag": "section",
  "class": "am-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "A small edit, considered"
    },
    {
  "type": "text",
  "id": "headline_plain",
  "label": "Headline — plain part",
  "default": "Jewellery with"
},
{
  "type": "text",
  "id": "headline_italic",
  "label": "Headline — italic part",
  "default": "a point of view."
},
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A curated edit of bold enamel jewellery in cobalt, vermilion, and recycled silver. Pieces selected for their geometry, their colour, and the conviction with which they were made."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Button label",
      "default": "Shop the Edit"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Button label",
      "default": "The Philosophy"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Trust strip"
    },
    {
      "type": "checkbox",
      "id": "show_trust_strip",
      "label": "Show trust strip",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "Curated in London"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Small Editions"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "Free UK Delivery"
    }
  ],
  "presets": [
    {
      "name": "AM — Hero"
    }
  ]
}
{% endschema %}