    "custom_liquid_frLff7": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .am-feature-card { max-width: 1200px; margin: 0 auto; padding: clamp(24px, 5vw, 40px) 20px; box-sizing: border-box; width: 100%; }\n  .am-feature-card__row {\n  display: grid;\n  grid-template-columns: 1.2fr 1fr;\n  gap: clamp(24px, 4vw, 40px);\n  align-items: stretch;\n  width: 100%;\n}\n\n@media (max-width: 900px) {\n  .am-feature-card__row {\n    grid-template-columns: 1fr;\n  }\n}\n  .am-feature-card__media { min-width: 0; overflow: hidden; width: 100%; display: flex; align-items: center; }\n  .am-feature-card__media video { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.4); transform-origin: center center; }\n\n  .am-feature-card__video-wrap { position: relative; width: 100%; height: 100%; }\n  .am-feature-card__play-btn {\n    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);\n    width: 64px; height: 64px; border-radius: 50%;\n    background: rgba(0,0,0,0.5); border: none; cursor: pointer;\n    display: flex; align-items: center; justify-content: center;\n    transition: background 0.2s ease; z-index: 2;\n  }\n  .am-feature-card__play-btn:hover { background: rgba(0,0,0,0.7); }\n  .am-feature-card__play-btn.is-hidden { display: none; }\n  .am-feature-card__copy { min-width: 0; text-align: left; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; background: #fdf6e3; padding: clamp(24px, 4vw, 35px); border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.02); border: 1px solid rgba(0,0,0,0.03); }\n.am-feature-card__eyebrow { font-size: 13px; font-weight: 600; letter-spacing: 3px; color: #8a8a8a; text-transform: uppercase; margin-bottom: 6px; display: block; text-align: center; }\n  .am-feature-card__headline { margin: 0 0 25px; font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 22px; color: #0047AB; letter-spacing: -0.3px; line-height: 1.15; text-align: center; }\n  .am-feature-card__subtitle { margin: 0 0 22px; font-size: 16px; font-weight: 600; font-style: italic; color: #555; letter-spacing: 0.3px; line-height: 1.3; }\n  .am-feature-card__body { margin: 0 0 18px; font-size: 14px; line-height: 1.6; color: #121212; font-weight: 300; }\n  .am-feature-card__body--secondary { color: #333; }\n\n  .am-feature-card__credentials { border-top: 1px solid rgba(0,0,0,0.08); border-bottom: 1px solid rgba(0,0,0,0.08); padding: 20px 0; margin-bottom: 28px; display: flex; flex-direction: column; gap: 12px; }\n  .am-feature-card__credential { display: flex; align-items: flex-start; gap: 12px; font-size: 14px; color: #121212; font-weight: 500; line-height: 1.4; }\n  .am-feature-card__credential-icon { color: #0047AB; font-size: 1.25rem; line-height: 1; }\n\n  .am-feature-card__cta { display: inline-block; width: 100%; text-align: center; padding: 18px 0; background: #0047AB; color: #fff; text-decoration: none; font-size: 1rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; border-radius: 4px; transition: opacity 0.2s ease; line-height: 1; box-shadow: 0 4px 12px rgba(0,71,171,0.2); }\n  .am-feature-card__cta:hover { opacity: 0.9; }\n\n  @media (max-width: 640px) {\n    .am-feature-card__row { gap: 24px; }\n    .am-feature-card__copy { padding: 24px 20px; }\n  }\n</style>\n\n<div class=\"am-feature-card\">\n  <div class=\"am-feature-card__row\">\n\n    <div class=\"am-feature-card__media\">\n      <div class=\"am-feature-card__video-wrap\">\n        <video class=\"am-feature-card__video\" muted loop playsinline preload=\"none\" poster=\"https://cdn.shopify.com/s/files/1/0974/7480/6097/files/Compressed_Kasun_Pendants_Picture.webp?v=1789049135\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/4b04c30f04594b94bf410abd5a0441c6.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"am-feature-card__play-btn\" aria-label=\"Play video\" type=\"button\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"am-feature-card__copy\">\n      <span class=\"am-feature-card__eyebrow\">Featured Design</span>\n      <div class=\"am-feature-card__headline\">The Kasun Kintsugi Smile Pendant</div>\n\n      <p class=\"am-feature-card__body\">\n         \nDesigned by award-winning goldsmith Kasun Ekanayake. Set into a delicate 19mm coin and filled with six embedded garnets.  A completely original piece of signature, wearable, art.\n     \n      </p>\n\n      \n   \n\n      <div class=\"am-feature-card__credentials\">\n        <div class=\"am-feature-card__credential\">\n          <span class=\"am-feature-card__credential-icon\">🏆</span>\n          <span>Three-Time Winner · Goldsmiths' Craft & Design Council Awards</span>\n        </div>\n        <div class=\"am-feature-card__credential\">\n          <span class=\"am-feature-card__credential-icon\">✨</span>\n          <span>Worn By · Cara Delevingne, St Vincent + FKA Twigs</span>\n        </div>\n        <div class=\"am-feature-card__credential\">\n          <span class=\"am-feature-card__credential-icon\">📰</span>\n          <span>Profiled In · Wallpaper*, Financial Times, Harper's Bazaar, Lost in Jewellery, Elle</span>\n        </div>\n      </div>\n\n      <a href=\"https://ateliermodernista.com/products/silver-and-garnet-smile-pendant\" class=\"am-feature-card__cta\">\n        Order Your Pendant\n      </a>\n    </div>\n\n  </div>\n</div>\n\n<script>\ndocument.querySelectorAll('.am-feature-card__video-wrap').forEach(function(wrap) {\n  var video = wrap.querySelector('video');\n  var btn = wrap.querySelector('.am-feature-card__play-btn');\n  btn.addEventListener('click', function() {\n    video.play();\n    btn.classList.add('is-hidden');\n  });\n});\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 8
      }
