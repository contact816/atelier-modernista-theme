        "custom_liquid_aeoFaq1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  FAQ accordion + FAQPage JSON-LD -- AEO sprint, Week 2 Day 1.\n  Self-filters to 7 specific PDPs by handle; renders nothing on any\n  other product. Every answer is sourced from copy already live\n  elsewhere on this site (see PR notes for exact sources) -- nothing\n  here is newly invented marketing copy. Visible text and JSON-LD text\n  are generated from the same assigned variables so they always match\n  word for word.\n{%- endcomment -%}\n{%- liquid\n  assign faq_handles = 'eclat-14k-gold-vermeil-necklace,the-cobalt-edition-necklace,miro-spanish-dancer-earrings,miro-blue-necklace,miro-femme-et-oiseaux-golden-necklace,bauhaus-purple-red-earrings,architect-enamel-copper-earrings' | split: ','\n  assign faq_show = false\n  for h in faq_handles\n    if product.handle == h\n      assign faq_show = true\n    endif\n  endfor\n-%}\n{%- if faq_show -%}\n  {%- liquid\n    assign faq_is_miro = false\n    if product.title contains 'Miró' or product.title contains 'Miro'\n      assign faq_is_miro = true\n    endif\n\n    assign faq_material = ''\n    assign faq_material_field = product.metafields.general.materials\n    if faq_material_field.type == 'metaobject_reference'\n      assign faq_mo = faq_material_field.value\n      assign faq_material = faq_mo.fields.display_name.value | default: faq_mo.fields.name.value | default: faq_mo.fields.title.value\n    elsif faq_material_field.type == 'list.metaobject_reference'\n      assign faq_material_list = ''\n      for faq_mo in faq_material_field.value\n        assign faq_mo_name = faq_mo.fields.display_name.value | default: faq_mo.fields.name.value | default: faq_mo.fields.title.value\n        if faq_mo_name != blank\n          assign faq_material_list = faq_material_list | append: faq_mo_name\n          unless forloop.last\n            assign faq_material_list = faq_material_list | append: ', '\n          endunless\n        endif\n      endfor\n      assign faq_material = faq_material_list\n    else\n      assign faq_material = faq_material_field.value\n    endif\n\n    if faq_material == blank\n      assign faq_slug_field = product.metafields['shopify']['jewelry-material']\n      if faq_slug_field.type == 'list.metaobject_reference'\n        assign faq_slug_list = ''\n        for faq_slug_mo in faq_slug_field.value\n          assign faq_slug_mo_name = faq_slug_mo.fields.display_name.value | default: faq_slug_mo.fields.name.value | default: faq_slug_mo.fields.title.value\n          if faq_slug_mo_name != blank\n            assign faq_slug_list = faq_slug_list | append: faq_slug_mo_name\n            unless forloop.last\n              assign faq_slug_list = faq_slug_list | append: ', '\n            endunless\n          endif\n        endfor\n        assign faq_material = faq_slug_list\n      else\n        assign faq_material_slug = faq_slug_field.value\n        if faq_material_slug != blank\n          assign faq_material_words = faq_material_slug | replace: '-', ' ' | split: ' '\n          assign faq_material = ''\n          for word in faq_material_words\n            assign faq_material_word = word | capitalize\n            assign faq_material = faq_material | append: faq_material_word | append: ' '\n          endfor\n          assign faq_material = faq_material | strip\n        endif\n      endif\n    endif\n\n    assign faq_q1 = 'Is this an officially licensed Miró piece?'\n    assign faq_a1 = 'Yes. This piece is part of the official Miró Collection, licensed by Successió Miró, and crafted in Spain by Joidart.'\n\n    assign faq_q2 = 'What is ' | append: product.title | append: ' made from?'\n    assign faq_a2 = product.title | append: ' is made from ' | append: faq_material | append: '.'\n\n    assign faq_q3 = 'How do I care for this piece?'\n    assign faq_a3 = 'An Atelier Modernista polishing cloth is enclosed with your purchase to help maintain your jewellery. Please limit exposure to water, fragrance, cosmetics, and chemicals, and remove the piece before showers, swimming, or exercise.'\n\n    assign faq_q4 = 'What is your returns policy?'\n    assign faq_a4 = '30-day returns are included with your purchase for most Atelier Modernista items, but please note that, in order to uphold the highest standards of hygiene and safety, pierced earrings are non-returnable. Luxury Gift Wrapping is also non-returnable.'\n\n    assign faq_q5 = 'How much does UK shipping cost, and how long does delivery take?'\n    assign faq_a5 = 'Orders dispatch within 1-2 days. Standard UK delivery costs £3.95, or is free for Atelier Circle members, and arrives within 1-4 days of dispatch. Express UK delivery is available for £7.95.'\n  -%}\n\n  <div class=\"am-faq\">\n    <!-- DEBUG-JEWELRY-MATERIAL-ITEMS\n    {% for item in product.metafields['shopify']['jewelry-material'].value %}\n    ITEM[{{ forloop.index }}]: raw=[{{ item }}] name=[{{ item.name }}] title=[{{ item.title }}] value=[{{ item.value }}] fields=[{{ item.fields }}] label=[{{ item.label }}] handle=[{{ item.handle }}] json=[{{ item | json }}]\n    {% endfor %}\n    -->\n    <h2 class=\"am-faq__heading\">Questions about this piece</h2>\n\n    {%- if faq_is_miro -%}\n      <details class=\"am-faq__item\">\n        <summary class=\"am-faq__question\">{{ faq_q1 }}</summary>\n        <div class=\"am-faq__answer\"><p>{{ faq_a1 }}</p></div>\n      </details>\n    {%- endif -%}\n\n    {%- if faq_material != blank -%}\n      <details class=\"am-faq__item\">\n        <summary class=\"am-faq__question\">{{ faq_q2 }}</summary>\n        <div class=\"am-faq__answer\"><p>{{ faq_a2 }}</p></div>\n      </details>\n    {%- endif -%}\n\n    <details class=\"am-faq__item\">\n      <summary class=\"am-faq__question\">{{ faq_q3 }}</summary>\n      <div class=\"am-faq__answer\"><p>{{ faq_a3 }}</p></div>\n    </details>\n\n    <details class=\"am-faq__item\">\n      <summary class=\"am-faq__question\">{{ faq_q4 }}</summary>\n      <div class=\"am-faq__answer\"><p>{{ faq_a4 }}</p></div>\n    </details>\n\n    {%- unless faq_is_miro -%}\n      <details class=\"am-faq__item\">\n        <summary class=\"am-faq__question\">{{ faq_q5 }}</summary>\n        <div class=\"am-faq__answer\"><p>{{ faq_a5 }}</p></div>\n      </details>\n    {%- endunless -%}\n  </div>\n\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org/\",\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {%- capture faq_json_entries -%}\n        {%- if faq_is_miro -%}\n          {\"@type\":\"Question\",\"name\":{{ faq_q1 | json }},\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":{{ faq_a1 | json }}}},\n        {%- endif -%}\n        {%- if faq_material != blank -%}\n          {\"@type\":\"Question\",\"name\":{{ faq_q2 | json }},\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":{{ faq_a2 | json }}}},\n        {%- endif -%}\n        {\"@type\":\"Question\",\"name\":{{ faq_q3 | json }},\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":{{ faq_a3 | json }}}},\n        {\"@type\":\"Question\",\"name\":{{ faq_q4 | json }},\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":{{ faq_a4 | json }}}}\n        {%- unless faq_is_miro -%}\n          ,{\"@type\":\"Question\",\"name\":{{ faq_q5 | json }},\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":{{ faq_a5 | json }}}}\n        {%- endunless -%}\n      {%- endcapture -%}\n      {{ faq_json_entries }}\n    ]\n  }\n  </script>\n\n  <style>\n  .am-faq{border-top:1px solid rgba(60,50,40,0.15);margin:2rem 0}\n  .am-faq__heading{font-family:'Jost',sans-serif;font-size:12px !important;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#3C3228;margin:1.2rem 0 0.4rem}\n  .am-faq__item{border-bottom:1px solid rgba(60,50,40,0.15)}\n  .am-faq__question{display:flex;justify-content:space-between;align-items:center;padding:1rem 0;cursor:pointer;list-style:none;font-family:'Jost',sans-serif;font-size:14px;font-weight:400;letter-spacing:0.02em;color:#3C3228}\n  .am-faq__question::-webkit-details-marker{display:none}\n  .am-faq__question::after{content:'';width:10px;height:10px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);transition:transform 0.25s;flex-shrink:0}\n  details[open] .am-faq__question::after{transform:rotate(-135deg)}\n  .am-faq__answer{padding:0 0 1.2rem}\n  .am-faq__answer p{font-family:'Cormorant Garamond',serif;font-size:1rem;font-weight:400;line-height:1.7;color:#3C3228;margin:0}\n  </style>\n{%- endif -%}"
          }
